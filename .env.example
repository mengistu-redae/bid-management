POSTGRES_USER=bidmgmt
POSTGRES_PASSWORD=bidmgmt

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# From Keycloak admin console -> bidmgmt realm -> Clients -> bidmgmt-bff -> Credentials,
# after first `docker compose up`.
BFF_CLIENT_SECRET=changeme-in-keycloak-console

SESSION_SECRET=changeme-long-random-string

# Only needed when this isn't running on localhost (a real server/domain) -
# the public hostname browsers use to reach Keycloak and node-bff. See
# DEPLOYMENT.md for why both node-bff and spring-boot-api need to agree on
# the Keycloak one.
# KEYCLOAK_ISSUER_PUBLIC_URI=https://bidmgmt.example.com/realms/bidmgmt
# BFF_BASE_URL=https://bidmgmt.example.com

# Email notifications (Phase 4) - defaults point at the bundled mailpit dev
# catcher. Point these at a real SMTP relay for production. See DEPLOYMENT.md.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# BIDMGMT_NOTIFICATIONS_ENABLED=true
# BIDMGMT_NOTIFICATIONS_FROM=bidmgmt@motiengineering.com
# BIDMGMT_DIRECTOR_EMAIL=mengistu.redae@motiengineering.com
# BIDMGMT_APP_BASE_URL=https://bidmgmt.example.com

# Telegram notification channel (optional, additive to email) - create a bot
# via @BotFather in Telegram, paste its token here. Each recipient then adds
# their own chat id from their profile page in the app. See DEPLOYMENT.md.
# BIDMGMT_TELEGRAM_BOT_TOKEN=
