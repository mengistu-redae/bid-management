<%- include('../partials/header', { title: title, user: user }) %>
<h1>New opportunity</h1>
<p class="muted">Pre-tender pipeline: a lead, RFI, or budget conversation that may later become a tender.</p>

<form class="card" method="post" action="/opportunities">
  <label>Organization name</label>
  <input name="organizationName" value="<%= form.organizationName || '' %>" required>

  <label>Sector</label>
  <select name="sector">
    <% ['BANK','GOVERNMENT','UTILITY','ENTERPRISE','OTHER'].forEach(s => { %>
      <option value="<%= s %>"><%= s %></option>
    <% }) %>
  </select>

  <label>Title</label>
  <input name="title" value="<%= form.title || '' %>" required>

  <div class="row">
    <div class="col">
      <label>Estimated value</label>
      <input type="number" step="0.01" name="estimatedValue" value="<%= form.estimatedValue || '' %>">
    </div>
    <div class="col">
      <label>Currency</label>
      <select name="estimatedValueCurrency">
        <option value="ETB">ETB</option>
        <option value="USD">USD</option>
      </select>
    </div>
    <div class="col">
      <label>Expected tender date</label>
      <input type="date" name="expectedTenderDate" value="<%= form.expectedTenderDate || '' %>">
    </div>
  </div>

  <label>Division(s)</label>
  <% divisions.forEach(d => { %>
    <label class="inline-label">
      <input type="checkbox" name="divisionCodes" value="<%= d.code %>" class="w-auto"> <%= d.name %>
    </label>
  <% }) %>

  <label>OEM(s)/vendor(s) involved (comma-separated - existing or new)</label>
  <input name="oemNames" value="<%= form.oemNames || '' %>" placeholder="e.g. Dell, Veeam" list="oem-options">
  <datalist id="oem-options">
    <% oems.forEach(o => { %><option value="<%= o.name %>"><% }) %>
  </datalist>

  <label>Owner</label>
  <select name="ownerId">
    <option value="">- unassigned -</option>
    <% users.forEach(u => { %><option value="<%= u.id %>"><%= u.fullName %> (<%= u.role %>)</option><% }) %>
  </select>

  <label>Notes</label>
  <textarea name="notes"><%= form.notes || '' %></textarea>

  <div class="mt-3">
    <button type="submit">Create opportunity</button>
    <a class="btn secondary" href="/opportunities">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
