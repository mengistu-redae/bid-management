<%- include('../partials/header', { title: title, user: user }) %>
<div class="toolbar">
  <h1 style="margin:0;">Deal Registrations</h1>
  <a class="btn" href="/deal-registrations/new">+ New Deal Registration</a>
</div>

<div class="table-scroll">
<table>
  <thead>
    <tr><th>Organization</th><th>OEM</th><th>Distributor</th><th>Status</th><th>Expiry</th><th></th></tr>
  </thead>
  <tbody>
    <% registrations.forEach(r => { %>
      <tr onclick="window.location='/deal-registrations/<%= r.id %>'" style="cursor:pointer;">
        <td><%= r.organization ? r.organization.name : '-' %></td>
        <td><%= r.oem ? r.oem.name : '-' %></td>
        <td><%= r.distributor || '-' %></td>
        <td><span class="badge <%= r.status === 'REJECTED' || r.status === 'EXPIRED' ? 'lost' : (r.status === 'APPROVED' ? 'won' : '') %>"><%= r.status %></span></td>
        <td><%= formatDate(r.expiryDate) %> <% if (r.expiringSoon) { %><span class="badge review">soon</span><% } %></td>
        <td><% if (r.conflictCount > 0) { %><span class="badge review"><%= r.conflictCount %> conflict<%= r.conflictCount > 1 ? 's' : '' %></span><% } %></td>
      </tr>
    <% }) %>
    <% if (registrations.length === 0) { %><tr><td colspan="6" class="muted">No deal registrations yet.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>
