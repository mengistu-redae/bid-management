<%- include('../partials/header', { title: title, user: user }) %>

<div class="toolbar">
  <div>
    <h1 style="margin:0;"><%= registration.oem.name %></h1>
    <div class="muted"><%= registration.organization.name %><% if (registration.registrationId) { %> &middot; Ref: <%= registration.registrationId %><% } %></div>
  </div>
  <span class="badge <%= registration.status === 'REJECTED' || registration.status === 'EXPIRED' ? 'lost' : (registration.status === 'APPROVED' ? 'won' : '') %>" style="font-size:1rem;"><%= registration.status %></span>
</div>

<% if (registration.conflictCount > 0) { %>
  <div class="warning-box"><strong><%= registration.conflictCount %> other active registration(s)</strong> exist for this customer + OEM. Check for duplicate protection before proceeding.</div>
<% } %>

<div class="card">
  <div style="display:flex; flex-wrap:wrap; gap:2rem;">
    <div><strong>Distributor</strong><br><%= registration.distributor || '-' %></div>
    <div><strong>Submitted</strong><br><%= formatDate(registration.submittedDate) %></div>
    <div><strong>Approved</strong><br><%= formatDate(registration.approvalDate) %></div>
    <div><strong>Expiry</strong><br><%= formatDate(registration.expiryDate) %> <% if (registration.expiringSoon) { %><span class="badge review">expiring soon</span><% } %></div>
    <div><strong>Protected discount</strong><br><%= registration.protectedDiscountPercent ? registration.protectedDiscountPercent + '%' : '-' %></div>
    <div><strong>Special price ref.</strong><br><%= registration.specialPriceReference || '-' %></div>
  </div>
  <% if (registration.notes) { %><p class="mt-2"><%= registration.notes %></p><% } %>
</div>

<div class="card">
  <h2 class="mt-0">Edit</h2>
  <form method="post" action="/deal-registrations/<%= registration.id %>/update">
    <div class="row">
      <div class="col">
        <label>Distributor</label>
        <input name="distributor" value="<%= registration.distributor || '' %>">
      </div>
      <div class="col">
        <label>Registration ID</label>
        <input name="registrationId" value="<%= registration.registrationId || '' %>">
      </div>
      <div class="col">
        <label>Status</label>
        <select name="status">
          <% statusOptions.forEach(s => { %><option value="<%= s %>" <%= s === registration.status ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="col">
        <label>Submitted date</label>
        <input type="date" name="submittedDate" value="<%= registration.submittedDate || '' %>">
      </div>
      <div class="col">
        <label>Approval date</label>
        <input type="date" name="approvalDate" value="<%= registration.approvalDate || '' %>">
      </div>
      <div class="col">
        <label>Expiry date</label>
        <input type="date" name="expiryDate" value="<%= registration.expiryDate || '' %>">
      </div>
    </div>
    <div class="row">
      <div class="col">
        <label>Protected discount %</label>
        <input type="number" step="0.01" name="protectedDiscountPercent" value="<%= registration.protectedDiscountPercent || '' %>">
      </div>
      <div style="flex:2;">
        <label>Special price reference</label>
        <input name="specialPriceReference" value="<%= registration.specialPriceReference || '' %>">
      </div>
    </div>
    <label>Notes</label>
    <textarea name="notes"><%= registration.notes || '' %></textarea>
    <div class="mt-2"><button type="submit">Save</button></div>
  </form>
</div>

<h2>Activity log</h2>
<div class="card">
  <% activity.forEach(entry => { %>
    <p style="margin:0.4rem 0;"><strong><%= entry.authorName || 'System' %></strong> <span class="muted"><%= formatDateTime(entry.createdAt) %></span><br><%= entry.note %></p>
  <% }) %>
  <% if (activity.length === 0) { %><p class="muted">No activity yet.</p><% } %>
  <form method="post" action="/deal-registrations/<%= registration.id %>/activity" style="display:flex; gap:0.5rem; margin-top:0.75rem;">
    <input name="note" placeholder="Add a note..." class="col" required>
    <button type="submit">Add</button>
  </form>
</div>

<%- include('../partials/footer') %>
