<%- include('../partials/header', { title: title, user: user }) %>
<h1 class="mt-0">
  <%= contract.contractNumber || 'Contract' %>
  <span class="badge <%= statusBadgeClass(contract.status) %>"><%= contract.status %></span>
  <% if (contract.onHold) { %><span class="badge stale">On hold</span><% } %>
</h1>
<p class="muted mt-0"><a href="/bids/<%= contract.bidId %>"><%= contract.bidTitle %></a></p>

<div class="card">
  <div class="row" style="gap:2rem;">
    <div>
      <div class="muted" style="font-size:0.85rem;">Signed</div>
      <div><%= contract.signedAt ? formatDate(contract.signedAt) : '-' %></div>
    </div>
    <div>
      <div class="muted" style="font-size:0.85rem;">Delivery deadline</div>
      <div><%= contract.deliveryDeadline ? formatDate(contract.deliveryDeadline) : '-' %></div>
    </div>
    <div>
      <div class="muted" style="font-size:0.85rem;">Completed</div>
      <div><%= contract.completedAt ? formatDate(contract.completedAt) : '-' %></div>
    </div>
    <% if (contract.indicator && contract.indicator.level !== 'NO_TARGET') { %>
      <div>
        <div class="muted" style="font-size:0.85rem;">Indicator</div>
        <div><a class="badge <%= indicatorBadgeClass(contract.indicator.level) %>" title="<%= indicatorLabel(contract.indicator) %>"
                href="<%= stageHistoryHref('CONTRACT', contract.id, { title: contract.contractNumber || 'Contract', subtitle: contract.bidTitle, backHref: '/contracts/' + contract.id, backLabel: 'Back to contract' }) %>"><%= contract.indicator.level %></a></div>
      </div>
    <% } %>
  </div>
  <% if (contract.exitReason) { %><p class="mt-2"><strong>Exit reason:</strong> <%= contract.exitReason %></p><% } %>
  <% if (contract.notes) { %><p class="mt-2"><strong>Notes:</strong> <%= contract.notes %></p><% } %>
</div>

<div class="card">
  <h2 class="mt-0">Update status</h2>
  <form method="post" action="/contracts/<%= contract.id %>/status" style="display:flex; gap:0.75rem; align-items:flex-end; flex-wrap:wrap;">
    <div style="flex:1; min-width:10rem;">
      <label>Status</label>
      <select name="newStatus">
        <% statusOptions.forEach(s => { %><option value="<%= s %>" <%= s === contract.status ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </div>
    <div style="flex:2; min-width:14rem;">
      <label>Reason (required for Terminated)</label>
      <input name="reason" placeholder="Why?">
    </div>
    <div style="flex:1; min-width:12rem;">
      <label>Delay reason (required if red/critical)</label>
      <select name="delayReasonCode">
        <option value="">-</option>
        <% delayReasonCodes.forEach(c => { %><option value="<%= c.code %>"><%= c.label %></option><% }) %>
      </select>
    </div>
    <div><button type="submit">Update</button></div>
  </form>
</div>

<div class="card">
  <h2 class="mt-0">Edit</h2>
  <form method="post" action="/contracts/<%= contract.id %>/update">
    <label>Contract number</label>
    <input name="contractNumber" value="<%= contract.contractNumber || '' %>">
    <label>Delivery deadline</label>
    <input type="date" name="deliveryDeadline" value="<%= contract.deliveryDeadline || '' %>">
    <label>Notes</label>
    <textarea name="notes"><%= contract.notes || '' %></textarea>
    <button type="submit" class="mt-2">Save</button>
  </form>
</div>

<div class="row" style="justify-content:space-between;">
  <h2 class="mt-0">Logistics</h2>
  <a class="btn secondary w-auto" href="/logistics/new?contractId=<%= contract.id %>">+ Add shipment</a>
</div>
<% if (logistics.length === 0) { %>
  <p class="muted">No shipments yet.</p>
<% } else { %>
  <div class="table-scroll">
  <table>
    <thead><tr><th>Mode</th><th>Status</th><th>ETA</th><th>Dispatched</th><th>Delivered</th></tr></thead>
    <tbody>
      <% logistics.forEach(s => { %>
        <tr onclick="window.location='/logistics/<%= s.id %>'" style="cursor:pointer;">
          <td><a href="/logistics/<%= s.id %>"><%= s.shipmentMode %></a></td>
          <td><span class="badge <%= statusBadgeClass(s.status) %>"><%= s.status %></span></td>
          <td><%= s.etaAt ? formatDate(s.etaAt) : '-' %></td>
          <td><%= s.dispatchedAt ? formatDate(s.dispatchedAt) : '-' %></td>
          <td><%= s.deliveredAt ? formatDate(s.deliveredAt) : '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
