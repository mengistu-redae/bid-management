<%- include('../partials/header', { title: title, user: user }) %>

<div class="toolbar">
  <div>
    <h1 style="margin:0;"><%= bid.title %></h1>
    <div class="muted"><%= bid.organization ? bid.organization.name : '-' %> <% if (bid.referenceNumber) { %>&middot; Ref: <%= bid.referenceNumber %><% } %></div>
  </div>
  <span class="badge <%= statusBadgeClass(bid.status) %>" style="font-size:1rem;"><%= bid.status %></span>
</div>

<div class="card">
  <div style="display:flex; flex-wrap:wrap; gap:2rem;">
    <div><strong>Closing</strong><br><%= formatDateTime(bid.closingAt) %></div>
    <div><strong>Opening</strong><br><%= formatDateTime(bid.openingAt) %></div>
    <div><strong>Clarification deadline</strong><br><%= formatDate(bid.clarificationDeadline) %></div>
    <div><strong>Bid validity</strong><br><%= bid.bidValidityDays ? bid.bidValidityDays + ' days' : '-' %></div>
    <div><strong>Scouted</strong><br><%= formatDate(bid.scoutedDate) %> <% if (bid.scouts.length) { %>(<%= bid.scouts.map(s => s.fullName).join(', ') %>)<% } %></div>
  </div>
  <% if (bid.notes) { %><p class="mt-2"><%= bid.notes %></p><% } %>
</div>

<% if (bid.canEdit) { %>
<div class="card">
  <h2 class="mt-0">Change status</h2>
  <form method="post" action="/bids/<%= bid.id %>/status" style="display:flex; gap:0.75rem; align-items:flex-end; flex-wrap:wrap;">
    <div style="flex:1; min-width:10rem;">
      <label>New status</label>
      <select name="newStatus">
        <% statusOptions.forEach(s => { %><option value="<%= s %>" <%= s === bid.status ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </div>
    <div style="flex:2; min-width:14rem;">
      <label>Reason (required for Dropped/Cancelled)</label>
      <input name="reason" placeholder="Why?">
    </div>
    <div><button type="submit">Update status</button></div>
  </form>
</div>
<% } %>

<h2>Lots</h2>
<% bid.lots.forEach(lot => { %>
  <div class="card">
    <div class="toolbar" style="margin-bottom:0.5rem;">
      <div>
        <strong><%= lot.lotLabel %></strong>
        <span class="muted"><%= lot.division ? lot.division.name : 'no division set' %></span>
        <% if (lot.needsReview) { %><span class="badge review">needs review</span><% } %>
      </div>
      <span class="badge <%= statusBadgeClass(lot.status) %>"><%= lot.status %></span>
    </div>

    <% if (lot.reviewNote) { %><div class="warning-box"><%= lot.reviewNote %></div><% } %>

    <div style="display:flex; flex-wrap:wrap; gap:1.5rem; font-size:0.9rem;">
      <div><strong>Estimated value</strong><br><%= formatMoney(lot.estimatedValue, lot.estimatedValueCurrency) %></div>
      <div>
        <strong>Bid bond</strong><br><%= formatMoney(lot.bidBondAmount, lot.bidBondCurrency) %> <% if (lot.bidBondValidityDays) { %>(<%= lot.bidBondValidityDays %> days)<% } %>
        <% if (lot.bidBondAmount) { %>
          <% if (lot.bidBondIssuingBank) { %><div class="muted"><%= lot.bidBondIssuingBank %><% if (lot.bidBondIssueDate) { %>, issued <%= formatDate(lot.bidBondIssueDate) %><% } %></div><% } %>
          <% if (lot.bidBondReturned) { %>
            <div class="muted">Returned <%= formatDate(lot.bidBondReturnedAt) %></div>
          <% } else if (bid.canEdit) { %>
            <form method="post" action="/bids/lots/<%= lot.id %>/bond-returned" class="inline">
              <input type="hidden" name="bidId" value="<%= bid.id %>">
              <button type="submit" class="secondary" style="padding:0.1rem 0.5rem; font-size:0.78rem;">Mark bond returned</button>
            </form>
          <% } %>
          <% if (bid.canEdit) { %>
            <details style="margin-top:0.3rem;">
              <summary class="muted" style="font-size:0.78rem;">Issuing bank / issue date</summary>
              <form method="post" action="/bids/lots/<%= lot.id %>/bond-details" style="display:flex; gap:0.4rem; margin-top:0.3rem;">
                <input type="hidden" name="bidId" value="<%= bid.id %>">
                <input name="issuingBank" placeholder="Bank" value="<%= lot.bidBondIssuingBank || '' %>" class="w-auto">
                <input type="date" name="issueDate" value="<%= lot.bidBondIssueDate || '' %>" class="w-auto">
                <button type="submit" class="secondary" style="padding:0.1rem 0.5rem; font-size:0.78rem;">Save</button>
              </form>
            </details>
          <% } %>
        <% } %>
      </div>
      <div><strong>OEM/brand</strong><br><%= lot.oemBrand || '-' %></div>
      <div><strong>Scope</strong><br><%= lot.scopeTypes.join(', ') || '-' %></div>
      <div><strong>Officers</strong><br><%= lot.accountOfficers.map(o => o.fullName).join(', ') || '-' %></div>
    </div>

    <% if (lot.outcome) { %>
      <p style="margin-top:0.75rem;"><strong><%= lot.outcome %></strong><% if (lot.winnerName) { %> - winner: <%= lot.winnerName %><% } %><% if (lot.winningPrice) { %>, price: <%= formatMoney(lot.winningPrice, lot.winningPriceCurrency) %><% } %></p>
    <% } %>

    <% if (bid.canEdit && (lot.status === 'UNDER_EVALUATION' || lot.status === 'WON' || lot.status === 'LOST')) { %>
      <details class="mt-1">
        <summary class="muted">Record outcome</summary>
        <form method="post" action="/bids/lots/<%= lot.id %>/outcome" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:0.5rem;">
          <input type="hidden" name="bidId" value="<%= bid.id %>">
          <select name="outcome" class="w-auto">
            <option value="">-</option>
            <option value="WON" <%= lot.outcome === 'WON' ? 'selected' : '' %>>Won</option>
            <option value="LOST" <%= lot.outcome === 'LOST' ? 'selected' : '' %>>Lost</option>
          </select>
          <input name="winnerName" placeholder="Winner" value="<%= lot.winnerName || '' %>" class="w-auto">
          <input type="number" step="0.01" name="winningPrice" placeholder="Winning price" value="<%= lot.winningPrice || '' %>" class="w-auto">
          <select name="winningPriceCurrency" class="w-auto">
            <option value="ETB">ETB</option>
            <option value="USD">USD</option>
          </select>
          <button type="submit">Save outcome</button>
        </form>
      </details>
    <% } %>

    <h3 style="margin-bottom:0.3rem;">Checklist (<%= lot.checklistProgressPercent %>%)</h3>
    <div class="progress-bar"><div style="width: <%= lot.checklistProgressPercent %>%;"></div></div>
    <% lot.checklistItems.forEach(item => { %>
      <div class="checklist-item <%= item.done ? 'done' : '' %>">
        <form method="post" action="/bids/checklist/<%= item.id %>/toggle">
          <input type="hidden" name="bidId" value="<%= bid.id %>">
          <input type="hidden" name="lotId" value="<%= lot.id %>">
          <input type="hidden" name="done" value="<%= !item.done %>">
          <button type="submit" class="secondary" style="padding:0.1rem 0.5rem;"><%= item.done ? '✓' : '□' %></button>
        </form>
        <span><%= item.title %></span>
        <% if (item.ownerName) { %><span class="muted">(<%= item.ownerName %>)</span><% } %>
        <% if (item.dueDate) { %><span class="muted">due <%= formatDate(item.dueDate) %></span><% } %>
      </div>
    <% }) %>

    <% if (bid.canEdit) { %>
    <form method="post" action="/bids/lots/<%= lot.id %>/checklist-items" style="display:flex; gap:0.5rem; margin-top:0.5rem;">
      <input type="hidden" name="bidId" value="<%= bid.id %>">
      <input name="title" placeholder="Add checklist item..." style="flex:2;">
      <input type="date" name="dueDate" class="col">
      <button type="submit" class="secondary">Add</button>
    </form>

    <details style="margin-top:0.75rem;">
      <summary class="muted">Change this lot's status independently</summary>
      <form method="post" action="/bids/lots/<%= lot.id %>/status" style="display:flex; gap:0.5rem; margin-top:0.5rem; flex-wrap:wrap;">
        <input type="hidden" name="bidId" value="<%= bid.id %>">
        <select name="newStatus" class="w-auto">
          <% statusOptions.forEach(s => { %><option value="<%= s %>" <%= s === lot.status ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
        <input name="reason" placeholder="Reason (if dropping/cancelling)" class="col">
        <button type="submit" class="secondary">Update lot status</button>
      </form>
    </details>
    <% } %>
  </div>
<% }) %>

<h2>Deal registrations</h2>
<div class="card">
  <% dealRegistrations.forEach(r => { %>
    <div class="checklist-item">
      <a href="/deal-registrations/<%= r.id %>"><%= r.oem.name %></a>
      <span class="badge <%= r.status === 'REJECTED' || r.status === 'EXPIRED' ? 'lost' : (r.status === 'APPROVED' ? 'won' : '') %>"><%= r.status %></span>
      <% if (r.conflictCount > 0) { %><span class="badge review"><%= r.conflictCount %> conflict<%= r.conflictCount > 1 ? 's' : '' %></span><% } %>
    </div>
  <% }) %>
  <% if (dealRegistrations.length === 0) { %><p class="muted">No deal registrations linked to this bid.</p><% } %>
  <a class="btn secondary mt-1" href="/deal-registrations/new">+ New deal registration</a>
</div>

<h2>Activity log</h2>
<div class="card">
  <% activity.forEach(entry => { %>
    <p style="margin:0.4rem 0;"><strong><%= entry.authorName || 'Import' %></strong> <span class="muted"><%= formatDateTime(entry.createdAt) %></span><br><%= entry.note %></p>
  <% }) %>
  <% if (activity.length === 0) { %><p class="muted">No activity yet.</p><% } %>
  <form method="post" action="/bids/<%= bid.id %>/activity" style="display:flex; gap:0.5rem; margin-top:0.75rem;">
    <input name="note" placeholder="Add a note..." class="col" required>
    <button type="submit">Add</button>
  </form>
</div>

<h2>Status history</h2>
<div class="table-scroll">
<table>
  <thead><tr><th>From</th><th>To</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
  <tbody>
    <% history.forEach(h => { %>
      <tr><td><%= h.fromStatus || '-' %></td><td><%= h.toStatus %></td><td><%= h.reason || '-' %></td><td><%= h.changedByName || 'Import' %></td><td><%= formatDateTime(h.changedAt) %></td></tr>
    <% }) %>
    <% if (history.length === 0) { %><tr><td colspan="5" class="muted">No status changes yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<%- include('../partials/footer') %>
