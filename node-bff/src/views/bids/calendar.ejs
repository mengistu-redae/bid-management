<%- include('../partials/header', { title: title, user: user }) %>
<% const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
   const prevMonth = month === 1 ? 12 : month - 1;
   const prevYear = month === 1 ? year - 1 : year;
   const nextMonth = month === 12 ? 1 : month + 1;
   const nextYear = month === 12 ? year + 1 : year;
   const INLINE_LIMIT = 4;
   function kindLabel(kind) {
     if (kind === 'closing') return 'Closing';
     if (kind === 'opening') return 'Opening';
     return 'Clarification deadline';
   }
   function timeOnly(iso) {
     const parts = formatDateTime(iso).split(' ');
     return parts.length > 1 ? parts[1] : '';
   }
%>
<div class="toolbar">
  <h1 style="margin:0;"><%= monthNames[month - 1] %> <%= year %></h1>
  <a class="btn secondary" href="/bids/calendar?year=<%= prevYear %>&month=<%= prevMonth %>">&laquo; Prev</a>
  <a class="btn secondary" href="/bids/calendar?year=<%= nextYear %>&month=<%= nextMonth %>">Next &raquo;</a>
  <a class="btn secondary" href="/bids">List view</a>
  <a class="btn secondary" href="/dashboard">Dashboard</a>
</div>

<div class="row tight muted mt-0" style="margin-bottom:0.75rem;">
  <span><span class="cal-dot closing"></span> Closing</span>
  <span><span class="cal-dot opening"></span> Opening</span>
  <span><span class="cal-dot clarification"></span> Clarification deadline</span>
</div>

<div class="table-scroll">
<div class="calendar-grid">
  <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %>
    <div class="calendar-weekday"><%= d %></div>
  <% }) %>
  <% days.forEach(cell => { %>
    <%
      const hasEvents = cell.events.length > 0;
      const modalId = 'day-modal-' + cell.date;
      const cellClasses = ['calendar-cell'];
      if (!cell.inMonth) cellClasses.push('out-of-month');
      if (cell.date === todayKey) cellClasses.push('today');
      if (hasEvents) cellClasses.push('clickable');
    %>
    <div class="<%= cellClasses.join(' ') %>"<% if (hasEvents) { %> onclick="document.getElementById('<%= modalId %>').showModal()"<% } %>>
      <div class="calendar-cell-day"><%= cell.day %></div>
      <% cell.events.slice(0, INLINE_LIMIT).forEach(ev => { %>
        <a href="/bids/<%= ev.bidId %>" class="calendar-event" title="<%= ev.title %>" onclick="event.stopPropagation()">
          <span class="cal-dot <%= ev.kind %>"></span><%= ev.title %>
        </a>
      <% }) %>
      <% if (cell.events.length > INLINE_LIMIT) { %>
        <button type="button" class="calendar-more" onclick="event.stopPropagation(); document.getElementById('<%= modalId %>').showModal()">+<%= cell.events.length - INLINE_LIMIT %> more</button>
      <% } %>
    </div>
  <% }) %>
</div>
</div>

<% days.forEach(cell => { %>
  <% if (cell.events.length === 0) return; %>
  <dialog id="day-modal-<%= cell.date %>" class="day-modal">
    <div class="day-modal-header">
      <h3><%= formatDate(cell.date) %></h3>
      <button type="button" class="secondary btn-xs" onclick="this.closest('dialog').close()">Close</button>
    </div>
    <% cell.events.forEach(ev => { %>
      <div class="day-modal-event">
        <span class="cal-dot <%= ev.kind %>"></span>
        <div class="col">
          <a href="/bids/<%= ev.bidId %>"><%= ev.title %></a>
          <div class="muted"><%= ev.organizationName %> &middot; <%= kindLabel(ev.kind) %> <%= timeOnly(ev.time) %></div>
          <% if (ev.redFlag) { %><span class="badge review mt-1"><%= ev.redFlagReason %></span><% } %>
        </div>
        <span class="badge <%= statusBadgeClass(ev.status) %>"><%= ev.status %></span>
      </div>
    <% }) %>
  </dialog>
<% }) %>

<%- include('../partials/footer') %>
