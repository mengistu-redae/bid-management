<%- include('../partials/header', { title: title, user: user }) %>
<div class="toolbar">
  <h1 style="margin:0;">Bids</h1>
  <a class="btn" href="/bids/new">+ New Tender</a>
  <a class="btn secondary" href="/bids/kanban<%= Object.keys(query).length ? '?' + new URLSearchParams(query).toString() : '' %>">Kanban</a>
  <a class="btn secondary" href="/bids/calendar">Calendar</a>
  <a class="btn secondary" href="/dashboard">Dashboard</a>
  <a class="btn secondary" hx-boost="false" href="/bids/export<%= Object.keys(query).length ? '?' + new URLSearchParams(query).toString() : '' %>">Export to Excel</a>
</div>

<form method="get" action="/bids" class="card toolbar" style="margin-bottom:1rem;">
  <select name="divisionId" class="w-auto">
    <option value="">All divisions</option>
    <% divisions.forEach(d => { %><option value="<%= d.id %>" <%= query.divisionId === d.id ? 'selected' : '' %>><%= d.name %></option><% }) %>
  </select>
  <select name="status" class="w-auto">
    <option value="">All statuses</option>
    <% statusOptions.forEach(s => { %><option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
  </select>
  <select name="officerId" class="w-auto">
    <option value="">All officers</option>
    <% users.filter(u => u.role === 'ACCOUNT_OFFICER').forEach(u => { %><option value="<%= u.id %>" <%= query.officerId === u.id ? 'selected' : '' %>><%= u.fullName %></option><% }) %>
  </select>
  <select name="organizationId" class="w-auto">
    <option value="">All organizations</option>
    <% organizations.forEach(o => { %><option value="<%= o.id %>" <%= query.organizationId === o.id ? 'selected' : '' %>><%= o.name %></option><% }) %>
  </select>
  <label class="muted" style="margin:0;">Closing from</label>
  <input type="date" name="closingFrom" value="<%= query.closingFrom || '' %>" class="w-auto">
  <label class="muted" style="margin:0;">to</label>
  <input type="date" name="closingTo" value="<%= query.closingTo || '' %>" class="w-auto">
  <button type="submit" class="secondary">Filter</button>
  <a class="btn secondary" href="/bids">Clear</a>
</form>

<div class="table-scroll">
<table>
  <thead>
    <tr>
      <th>Organization</th>
      <th>Title</th>
      <th>Division(s)</th>
      <th>Closing</th>
      <th>Status</th>
      <th>Lots</th>
    </tr>
  </thead>
  <tbody>
    <% bids.forEach(bid => { %>
      <tr onclick="window.location='/bids/<%= bid.id %>'" style="cursor:pointer;">
        <td><%= bid.organization ? bid.organization.name : '-' %></td>
        <td><%= bid.title %><% if (bid.referenceNumber) { %><div class="muted"><%= bid.referenceNumber %></div><% } %></td>
        <td><%= bid.lots.map(l => l.division ? l.division.name : '?').join(', ') %></td>
        <td><%= formatDate(bid.closingAt) %></td>
        <td><span class="badge <%= statusBadgeClass(bid.status) %>"><%= bid.status %></span></td>
        <td><%= bid.lots.length %></td>
      </tr>
    <% }) %>
    <% if (bids.length === 0) { %>
      <tr><td colspan="6" class="muted">No bids match these filters.</td></tr>
    <% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>
