<%- include('../partials/header', { title: title, user: user }) %>
<div class="toolbar">
  <h1 style="margin:0;">Bids by division</h1>
  <a class="btn secondary" href="/bids<%= Object.keys(query).length ? '?' + new URLSearchParams(query).toString() : '' %>">List view</a>
  <a class="btn secondary" href="/dashboard">Dashboard</a>
</div>

<%- include('../partials/bidFilterForm', { action: '/bids/by-division' }) %>

<%
  function slugify(key) {
    return key.toString().toLowerCase().replace(/[^a-z0-9]+/g, '-');
  }
%>
<% groups.forEach(group => { %>
  <% const tbodyId = 'group-tbody-' + slugify(group.key); %>
  <h2><%= group.label %> <span class="muted">(<%= group.rows.length %>)</span></h2>
  <% if (group.rows.length === 0) { %>
    <p class="muted">-</p>
  <% } else { %>
    <div class="card">
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Organization</th>
          <th>Title</th>
          <th>Division(s)</th>
          <th>Closing</th>
          <th>Status</th>
          <th>Lots</th>
        </tr>
      </thead>
      <tbody id="<%= tbodyId %>">
        <% group.rows.forEach((bid, i) => { %>
          <%- include('../partials/bidRow', { bid, hidden: i >= groupLimit }) %>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% if (group.rows.length > groupLimit) { %>
      <button type="button" class="secondary w-auto mt-1" data-show-all="<%= tbodyId %>">Show all <%= group.rows.length %></button>
    <% } %>
    </div>
  <% } %>
<% }) %>

<script>
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-show-all]');
    if (!btn) return;
    document.querySelectorAll('#' + btn.dataset.showAll + ' tr[hidden]').forEach(function (row) { row.hidden = false; });
    btn.remove();
  });
</script>

<%- include('../partials/footer') %>
