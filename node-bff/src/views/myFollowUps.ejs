<%- include('partials/header', { title: title, user: user }) %>
<h1>My Follow-ups</h1>
<p class="muted">Follow-ups you own (bid lots, contracts, logistics shipments, opportunities, and deal registrations), plus bid lots you're the assigned officer on that need attention.</p>

<%
function renderRow(row, borderColor) {
%>
  <div class="card" style="padding:0.75rem 1rem;<%= borderColor ? ' border-color:' + borderColor + ';' : '' %>">
    <div class="row" style="justify-content:space-between; align-items:flex-start; flex-wrap:wrap;">
      <div>
        <a href="<%= row.detailHref %>" style="font-weight:600;"><%= row.bidTitle %></a>
        <% if (row.lotLabel) { %><span class="muted"> &middot; <%= row.lotLabel %></span><% } %>
        <% if (row.entityType !== 'LOT') { %><span class="badge" style="margin-left:0.4rem;"><%= row.entityType %></span><% } %>
        <div class="muted" style="font-size:0.85rem;"><%= row.organizationName || '-' %><% if (row.divisionName) { %> &middot; <%= row.divisionName %><% } %></div>
      </div>
      <div class="row" style="gap:0.4rem;">
        <span class="badge <%= statusBadgeClass(row.status) %>"><%= row.status %></span>
        <span class="badge <%= indicatorBadgeClass(row.indicatorLevel) %>"><%= row.indicatorLevel %></span>
        <% if (row.stale) { %><span class="badge stale">stale</span><% } %>
      </div>
    </div>
    <div class="row mt-1" style="font-size:0.85rem;">
      <span>Next follow-up: <%= row.nextFollowUpDate || 'not set' %></span>
    </div>
    <details class="mt-1">
      <summary class="muted" style="font-size:0.8rem;">Log follow-up / snooze</summary>
      <form method="post" action="/my-follow-ups/follow-up" class="row tight mt-1">
        <input type="hidden" name="entityType" value="<%= row.entityType %>">
        <input type="hidden" name="entityId" value="<%= row.entityId %>">
        <input name="note" placeholder="Follow-up note" class="col">
        <input type="date" name="nextFollowUpDate" class="w-auto">
        <select name="ownerId" class="w-auto">
          <option value="">Follow-up owner...</option>
          <% users.forEach(u => { %><option value="<%= u.id %>"><%= u.fullName %></option><% }) %>
        </select>
        <button type="submit" class="secondary btn-xs">Save follow-up</button>
      </form>
      <form method="post" action="/my-follow-ups/snooze" class="row tight mt-1">
        <input type="hidden" name="entityType" value="<%= row.entityType %>">
        <input type="hidden" name="entityId" value="<%= row.entityId %>">
        <input name="reason" placeholder="Snooze reason (required)" class="col">
        <input type="date" name="snoozedUntil" class="w-auto">
        <button type="submit" class="secondary btn-xs">Snooze</button>
      </form>
    </details>
  </div>
<%
}
%>

<h2>Overdue</h2>
<% if (data.overdue.length === 0) { %><p class="muted">Nothing overdue.</p><% } %>
<div class="col" style="gap:0.6rem;">
<% data.overdue.forEach(row => { renderRow(row, 'var(--danger)'); }) %>
</div>

<h2 class="mt-3">Due today</h2>
<% if (data.dueToday.length === 0) { %><p class="muted">Nothing due today.</p><% } %>
<div class="col" style="gap:0.6rem;">
<% data.dueToday.forEach(row => { renderRow(row); }) %>
</div>

<h2 class="mt-3">Turning amber soon</h2>
<p class="muted" style="font-size:0.85rem;">Bid lots you're the officer on, or contracts/logistics/opportunities/deal registrations you own the follow-up for, that are still green but approaching the amber threshold.</p>
<% if (data.turningAmberSoon.length === 0) { %><p class="muted">Nothing approaching its target yet.</p><% } %>
<div class="col" style="gap:0.6rem;">
<% data.turningAmberSoon.forEach(row => { renderRow(row); }) %>
</div>

<h2 class="mt-3">Stale (no recent activity)</h2>
<% if (data.stale.length === 0) { %><p class="muted">Nothing stale.</p><% } %>
<div class="col" style="gap:0.6rem;">
<% data.stale.forEach(row => { renderRow(row); }) %>
</div>

<%- include('partials/footer') %>
