<%- include('partials/header', { title: title, user: user }) %>
<h1>Delay analytics</h1>
<p class="muted">Bottleneck reports built from real stage-history data - scoped to the bid pipeline (per-lot), same as the Delays board. Date-range filter applies to when a stage was entered / a date changed.</p>

<form method="get" action="/reports/delay-analytics" class="card toolbar" style="margin-bottom:1rem;">
  <label class="muted" style="margin:0;">From <input type="date" name="from" value="<%= query.from || '' %>" class="w-auto"></label>
  <label class="muted" style="margin:0;">To <input type="date" name="to" value="<%= query.to || '' %>" class="w-auto"></label>
  <button type="submit" class="secondary">Apply</button>
  <a class="btn secondary" href="/reports/delay-analytics">Clear</a>
  <a class="btn secondary" hx-boost="false" href="/reports/delay-analytics/export?from=<%= query.from || '' %>&to=<%= query.to || '' %>">Export to Excel</a>
</form>

<h2>Per-stage duration (business days)</h2>
<div class="table-scroll">
<table>
  <thead><tr><th>Stage</th><th>Completed</th><th>Avg</th><th>Median</th><th>P90</th><th>% over target</th></tr></thead>
  <tbody>
    <% report.stageDurations.forEach(s => { %>
      <tr>
        <td><%= s.stageValue %></td>
        <td><%= s.completedCount %></td>
        <td><%= s.avgBusinessDays %></td>
        <td><%= s.medianBusinessDays %></td>
        <td><%= s.p90BusinessDays %></td>
        <td><%= s.percentOverTarget %>%</td>
      </tr>
    <% }) %>
    <% if (report.stageDurations.length === 0) { %><tr><td colspan="6" class="muted">No completed stage segments in this range yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<h2 id="monthly-trend" class="mt-3">Monthly trend</h2>
<div class="table-scroll">
<table>
  <thead><tr><th>Stage</th><th>Month</th><th>Completed</th><th>Avg (bd)</th></tr></thead>
  <tbody>
    <% report.monthlyTrend.forEach(m => { %>
      <tr><td><%= m.stageValue %></td><td><%= m.yearMonth %></td><td><%= m.completedCount %></td><td><%= m.avgBusinessDays %></td></tr>
    <% }) %>
    <% if (report.monthlyTrend.length === 0) { %><tr><td colspan="4" class="muted">No data yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<h2 id="breakdowns" class="mt-3">Breakdowns</h2>
<div class="row top">
  <div class="card col">
    <strong>By division - total delay days</strong>
    <%- include('partials/barChart', { rows: report.byDivision.map(r => ({ label: r.key, value: r.totalDelayDays, displayValue: r.totalDelayDays })) }) %>
  </div>
  <div class="card col">
    <strong>By officer - total delay days</strong>
    <%- include('partials/barChart', { rows: report.byOfficer.map(r => ({ label: r.key, value: r.totalDelayDays, displayValue: r.totalDelayDays })) }) %>
  </div>
</div>
<div class="row top mt-2">
  <div class="card col">
    <strong>By customer - total delay days</strong>
    <%- include('partials/barChart', { rows: report.byCustomer.slice(0, 10).map(r => ({ label: r.key, value: r.totalDelayDays, displayValue: r.totalDelayDays })) }) %>
  </div>
  <div class="card col">
    <strong>By OEM - total delay days</strong>
    <%- include('partials/barChart', { rows: report.byOem.map(r => ({ label: r.key, value: r.totalDelayDays, displayValue: r.totalDelayDays })) }) %>
  </div>
</div>

<h2 id="delay-reason-pareto" class="mt-3">Delay reason Pareto</h2>
<div class="card">
  <%- include('partials/barChart', { rows: report.delayReasonPareto.map(r => ({ label: r.label, value: r.totalDelayDays, displayValue: r.totalDelayDays + 'd (' + r.occurrences + 'x)' })) }) %>
</div>

<h2 class="mt-3">Date slippage</h2>
<h3 class="mt-1">By field</h3>
<div class="table-scroll">
<table>
  <thead><tr><th>Entity type</th><th>Field</th><th>Total changes</th><th>Total slippage (days)</th></tr></thead>
  <tbody>
    <% report.slippageByField.forEach(f => { %>
      <tr><td><%= f.entityType %></td><td><%= f.fieldName %></td><td><%= f.totalChangeCount %></td><td><%= f.totalSlippageDays %></td></tr>
    <% }) %>
    <% if (report.slippageByField.length === 0) { %><tr><td colspan="4" class="muted">No key-date changes in this range yet.</td></tr><% } %>
  </tbody>
</table>
</div>
<h3 class="mt-2">Most-changed records</h3>
<div class="table-scroll">
<table>
  <thead><tr><th>Type</th><th>Record</th><th>Field</th><th>Changes</th><th>Slippage (days)</th></tr></thead>
  <tbody>
    <% report.topDateSlippage.forEach(r => { %>
      <tr><td><%= r.entityType %></td><td><%= r.label %></td><td><%= r.fieldName %></td><td><%= r.changeCount %></td><td><%= r.slippageDays !== null ? r.slippageDays : '-' %></td></tr>
    <% }) %>
    <% if (report.topDateSlippage.length === 0) { %><tr><td colspan="5" class="muted">No key-date changes in this range yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<h2 class="mt-3">Who we're waiting on most</h2>
<p class="muted" style="font-size:0.85rem;">Open-item days, including items still waiting right now - not a resolved-only figure.</p>
<div class="card">
  <%- include('partials/barChart', { rows: report.waitingOnTotals.map(r => ({ label: r.partyType, value: r.totalDaysWaited, displayValue: r.totalDaysWaited + 'd (' + r.episodeCount + ' item(s))' })) }) %>
</div>

<%- include('partials/footer') %>
