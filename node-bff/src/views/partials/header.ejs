<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' - Bid Management' : 'Bid Management' %></title>
  <script>
    // Applied before app.css loads, so there's no flash of the wrong theme
    // on first paint. No stored preference means "follow the system" -
    // app.css's prefers-color-scheme block handles that case on its own;
    // this only ever needs to act when the user has explicitly chosen.
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) { /* localStorage unavailable (private mode etc.) - just follow the system theme */ }
    })();
  </script>
  <link rel="stylesheet" href="/public/css/app.css">
  <script src="/vendor/htmx/htmx.min.js"></script>
</head>
<body hx-boost="true">
<div class="app-shell">
  <button type="button" id="sidebar-toggle" class="hamburger-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="sidebar">
    <span></span><span></span><span></span>
  </button>
  <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><a href="/dashboard">Bid Management</a></div>
    <nav class="sidebar-nav">
      <details class="sidebar-group" data-group="today" open>
        <summary class="sidebar-nav-heading">Today</summary>
        <div class="sidebar-group-items">
          <a href="/dashboard">Dashboard</a>
          <a href="/my-follow-ups">My follow-ups<% if (typeof navCounts !== 'undefined' && navCounts && navCounts.followUps > 0) { %><span class="nav-badge"><%= navCounts.followUps %></span><% } %></a>
          <a href="/delays">Delays<% if (typeof navCounts !== 'undefined' && navCounts && navCounts.delays > 0) { %><span class="nav-badge"><%= navCounts.delays %></span><% } %></a>
          <a href="/issues">Issues<% if (typeof navCounts !== 'undefined' && navCounts && navCounts.issues > 0) { %><span class="nav-badge"><%= navCounts.issues %></span><% } %></a>
          <a href="/bids/calendar">Calendar</a>
        </div>
      </details>

      <details class="sidebar-group" data-group="lifecycle" open>
        <summary class="sidebar-nav-heading">Lifecycle</summary>
        <div class="sidebar-group-items">
          <a href="/opportunities"><span class="nav-step">1</span> Opportunities</a>
          <a href="/deal-registrations"><span class="nav-step">2</span> Deal registrations</a>
          <a href="/bids"><span class="nav-step">3</span> Bids</a>
          <a href="/contracts"><span class="nav-step">4</span> Contracts</a>
          <a href="/logistics"><span class="nav-step">5</span> Logistics</a>
        </div>
      </details>

      <details class="sidebar-group" data-group="insight" open>
        <summary class="sidebar-nav-heading">Insight</summary>
        <div class="sidebar-group-items">
          <a href="/reports">Reports</a>
          <a href="/dashboard#bonds-outstanding">Bid bonds &amp; guarantees</a>
        </div>
      </details>

      <% if (typeof user !== 'undefined' && user && user.realm_access && user.realm_access.roles && user.realm_access.roles.includes('director')) { %>
        <details class="sidebar-group" data-group="admin" open>
          <summary class="sidebar-nav-heading">Admin</summary>
          <div class="sidebar-group-items">
            <a href="/users">Users</a>
            <a href="/settings">Settings</a>
          </div>
        </details>
      <% } %>

      <details class="sidebar-group" data-group="actions" open>
        <summary class="sidebar-nav-heading">Actions</summary>
        <div class="sidebar-group-items">
          <a href="/bids/new">+ New Tender</a>
          <a href="/import">Import</a>
        </div>
      </details>
    </nav>
    <div class="sidebar-footer">
      <button type="button" id="theme-toggle" class="secondary w-auto" aria-label="Switch color theme">Theme</button>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="muted sidebar-user"><%= user.name || user.email %></span>
        <form class="inline" method="post" action="/auth/logout" hx-boost="false"><button class="secondary w-auto" type="submit">Log out</button></form>
      <% } %>
    </div>
  </aside>
  <script>
    // Cycles light -> dark -> light. "System" (no stored preference) is the
    // starting state for a new browser, but once someone clicks this they've
    // made an explicit choice, so it's saved and no longer follows the OS.
    (function () {
      var toggle = document.getElementById('theme-toggle');
      var root = document.documentElement;

      function currentTheme() {
        var explicit = root.getAttribute('data-theme');
        if (explicit === 'light' || explicit === 'dark') return explicit;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function render() {
        toggle.textContent = currentTheme() === 'dark' ? 'Dark theme' : 'Light theme';
      }

      toggle.addEventListener('click', function () {
        var next = currentTheme() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) { /* ignore - falls back to session-only */ }
        render();
      });

      render();
    })();
  </script>
  <script>
    // Off-canvas sidebar on narrow screens: the hamburger button, a tap on the
    // backdrop, or Escape all close it. No explicit close-on-navigate handler
    // is needed - every page (boosted or not) re-renders this partial fresh,
    // so the drawer always starts closed again on the next page.
    (function () {
      var toggle = document.getElementById('sidebar-toggle');
      var sidebar = document.getElementById('sidebar');
      var backdrop = document.getElementById('sidebar-backdrop');

      function setOpen(open) {
        sidebar.classList.toggle('open', open);
        backdrop.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      toggle.addEventListener('click', function () {
        setOpen(!sidebar.classList.contains('open'));
      });
      backdrop.addEventListener('click', function () { setOpen(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
    })();
  </script>
  <script>
    // Each sidebar category is a native <details>, collapsed/expanded state
    // persisted per group so it survives the full-page re-render every
    // navigation does. Groups default open (server-rendered markup) - this
    // only needs to act on the ones a user previously collapsed.
    (function () {
      var STORAGE_KEY = 'sidebarCollapsedGroups';
      var collapsed;
      try {
        collapsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      } catch (e) { collapsed = []; }

      Array.prototype.forEach.call(document.querySelectorAll('.sidebar-group[data-group]'), function (group) {
        var id = group.getAttribute('data-group');
        if (collapsed.indexOf(id) !== -1) group.open = false;

        group.addEventListener('toggle', function () {
          var idx = collapsed.indexOf(id);
          if (!group.open && idx === -1) collapsed.push(id);
          if (group.open && idx !== -1) collapsed.splice(idx, 1);
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(collapsed)); } catch (e) { /* ignore - private mode etc. */ }
        });
      });
    })();
  </script>
  <script>
    // htmx's default behavior for a non-2xx response is to swap nothing and
    // fire these events silently - with hx-boost="true" on <body>, that means
    // a failed page navigation (e.g. the bid-detail route 503ing) left the
    // user on the old page with zero feedback. Falling back to a real
    // window.location navigation for a boosted request is the guaranteed fix:
    // it re-requests the same URL as a plain GET, so the browser renders the
    // server's own full error page (see error.ejs / index.js's error
    // handler - status code preserved) instead of silently going nowhere.
    (function () {
      function showFlash(message) {
        var main = document.querySelector('main');
        if (!main) return;
        var existing = document.getElementById('hx-error-flash');
        if (existing) existing.remove();
        var div = document.createElement('div');
        div.id = 'hx-error-flash';
        div.className = 'flash error';
        div.textContent = message;
        main.insertBefore(div, main.firstChild);
      }

      function handle(evt, networkOnly) {
        var detail = evt.detail || {};
        if (detail.boosted && detail.pathInfo && detail.pathInfo.requestPath) {
          window.location.assign(detail.pathInfo.requestPath);
          return;
        }
        var status = !networkOnly && detail.xhr ? detail.xhr.status : null;
        showFlash(networkOnly
          ? 'Could not reach the server. Check your connection and try again.'
          : 'Something went wrong' + (status ? ' (error ' + status + ')' : '') + '. Please try again.');
      }

      document.body.addEventListener('htmx:responseError', function (evt) { handle(evt, false); });
      document.body.addEventListener('htmx:sendError', function (evt) { handle(evt, true); });
    })();
  </script>
  <div class="app-content">
    <main>
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.message %></div>
    <% } %>
