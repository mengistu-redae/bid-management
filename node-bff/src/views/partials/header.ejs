<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' - Bid Management' : 'Bid Management' %></title>
  <script>
    // Applied before app.css loads, so there's no flash of the wrong theme
    // on first paint. No stored preference means "follow the system" -
    // app.css's prefers-color-scheme block handles that case on its own;
    // this only ever needs to act when the user has explicitly chosen.
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) { /* localStorage unavailable (private mode etc.) - just follow the system theme */ }
    })();
  </script>
  <link rel="stylesheet" href="/public/css/app.css">
  <script src="/vendor/htmx/htmx.min.js"></script>
</head>
<body hx-boost="true">
<div class="app-shell">
  <button type="button" id="sidebar-toggle" class="hamburger-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="sidebar">
    <span></span><span></span><span></span>
  </button>
  <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><a href="/dashboard">Bid Management</a></div>
    <nav class="sidebar-nav">
      <div class="sidebar-nav-heading">Today</div>
      <a href="/dashboard">Dashboard</a>
      <a href="/my-follow-ups">My follow-ups<% if (typeof navCounts !== 'undefined' && navCounts && navCounts.followUps > 0) { %><span class="nav-badge"><%= navCounts.followUps %></span><% } %></a>
      <a href="/delays">Delays<% if (typeof navCounts !== 'undefined' && navCounts && navCounts.delays > 0) { %><span class="nav-badge"><%= navCounts.delays %></span><% } %></a>
      <a href="/bids/calendar">Calendar</a>

      <div class="sidebar-nav-heading">Lifecycle</div>
      <a href="/opportunities"><span class="nav-step">1</span> Opportunities</a>
      <a href="/deal-registrations"><span class="nav-step">2</span> Deal registrations</a>
      <a href="/bids"><span class="nav-step">3</span> Bids</a>
      <a href="/contracts"><span class="nav-step">4</span> Contracts</a>

      <div class="sidebar-nav-heading">Insight</div>
      <a href="/reports">Reports</a>
      <a href="/dashboard#bonds-outstanding">Bid bonds &amp; guarantees</a>

      <% if (typeof user !== 'undefined' && user && user.realm_access && user.realm_access.roles && user.realm_access.roles.includes('director')) { %>
        <div class="sidebar-nav-heading">Admin</div>
        <a href="/users">Users</a>
      <% } %>
      <a href="/bids/new">+ New Tender</a>
      <a href="/import">Import</a>
    </nav>
    <div class="sidebar-footer">
      <button type="button" id="theme-toggle" class="secondary w-auto" aria-label="Switch color theme">Theme</button>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="muted sidebar-user"><%= user.name || user.email %></span>
        <form class="inline" method="post" action="/auth/logout" hx-boost="false"><button class="secondary w-auto" type="submit">Log out</button></form>
      <% } %>
    </div>
  </aside>
  <script>
    // Cycles light -> dark -> light. "System" (no stored preference) is the
    // starting state for a new browser, but once someone clicks this they've
    // made an explicit choice, so it's saved and no longer follows the OS.
    (function () {
      var toggle = document.getElementById('theme-toggle');
      var root = document.documentElement;

      function currentTheme() {
        var explicit = root.getAttribute('data-theme');
        if (explicit === 'light' || explicit === 'dark') return explicit;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function render() {
        toggle.textContent = currentTheme() === 'dark' ? 'Dark theme' : 'Light theme';
      }

      toggle.addEventListener('click', function () {
        var next = currentTheme() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) { /* ignore - falls back to session-only */ }
        render();
      });

      render();
    })();
  </script>
  <script>
    // Off-canvas sidebar on narrow screens: the hamburger button, a tap on the
    // backdrop, or Escape all close it. No explicit close-on-navigate handler
    // is needed - every page (boosted or not) re-renders this partial fresh,
    // so the drawer always starts closed again on the next page.
    (function () {
      var toggle = document.getElementById('sidebar-toggle');
      var sidebar = document.getElementById('sidebar');
      var backdrop = document.getElementById('sidebar-backdrop');

      function setOpen(open) {
        sidebar.classList.toggle('open', open);
        backdrop.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      toggle.addEventListener('click', function () {
        setOpen(!sidebar.classList.contains('open'));
      });
      backdrop.addEventListener('click', function () { setOpen(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
    })();
  </script>
  <div class="app-content">
    <main>
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.message %></div>
    <% } %>
