<%- include('../partials/header', { title: title, user: user }) %>
<h1 class="mt-0">
  <%= shipment.shipmentMode %> shipment
  <span class="badge <%= statusBadgeClass(shipment.status) %>"><%= shipment.status %></span>
  <% if (shipment.onHold) { %><span class="badge stale">On hold</span><% } %>
</h1>
<p class="muted mt-0"><a href="/contracts/<%= contract.id %>"><%= contract.contractNumber || 'Contract' %></a> &middot; <%= contract.bidTitle %></p>

<div class="card">
  <div class="row" style="gap:2rem;">
    <div>
      <div class="muted" style="font-size:0.85rem;">ETA</div>
      <div><%= shipment.etaAt ? formatDate(shipment.etaAt) : '-' %></div>
    </div>
    <div>
      <div class="muted" style="font-size:0.85rem;">Dispatched</div>
      <div><%= shipment.dispatchedAt ? formatDate(shipment.dispatchedAt) : '-' %></div>
    </div>
    <div>
      <div class="muted" style="font-size:0.85rem;">Arrived</div>
      <div><%= shipment.arrivedAt ? formatDate(shipment.arrivedAt) : '-' %></div>
    </div>
    <div>
      <div class="muted" style="font-size:0.85rem;">Customs cleared</div>
      <div><%= shipment.customsClearedAt ? formatDate(shipment.customsClearedAt) : '-' %></div>
    </div>
    <div>
      <div class="muted" style="font-size:0.85rem;">Delivered</div>
      <div><%= shipment.deliveredAt ? formatDate(shipment.deliveredAt) : '-' %></div>
    </div>
    <% if (shipment.indicator && shipment.indicator.level !== 'NO_TARGET') { %>
      <div>
        <div class="muted" style="font-size:0.85rem;">Indicator</div>
        <div><span class="badge <%= indicatorBadgeClass(shipment.indicator.level) %>"><%= shipment.indicator.level %></span></div>
      </div>
    <% } %>
  </div>
  <% if (shipment.notes) { %><p class="mt-2"><strong>Notes:</strong> <%= shipment.notes %></p><% } %>
</div>

<div class="card">
  <h2 class="mt-0">Update status</h2>
  <form method="post" action="/logistics/<%= shipment.id %>/status" style="display:flex; gap:0.75rem; align-items:flex-end; flex-wrap:wrap;">
    <div style="flex:1; min-width:10rem;">
      <label>Status</label>
      <select name="newStatus">
        <% statusOptions.forEach(s => { %><option value="<%= s %>" <%= s === shipment.status ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </div>
    <div style="flex:2; min-width:14rem;">
      <label>Note (optional)</label>
      <input name="reason" placeholder="Why?">
    </div>
    <div><button type="submit">Update</button></div>
  </form>
</div>

<div class="card">
  <h2 class="mt-0">Edit</h2>
  <form method="post" action="/logistics/<%= shipment.id %>/update">
    <label>Shipment mode</label>
    <select name="shipmentMode">
      <% modeOptions.forEach(m => { %><option value="<%= m %>" <%= m === shipment.shipmentMode ? 'selected' : '' %>><%= m %></option><% }) %>
    </select>
    <label>ETA</label>
    <input type="date" name="etaAt" value="<%= shipment.etaAt || '' %>">
    <label>Notes</label>
    <textarea name="notes"><%= shipment.notes || '' %></textarea>
    <button type="submit" class="mt-2">Save</button>
  </form>
</div>

<%- include('../partials/footer') %>
