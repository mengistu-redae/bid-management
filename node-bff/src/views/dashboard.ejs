<%- include('partials/header', { title: title, user: user }) %>
<script>document.documentElement.classList.add('tab-js');</script>

<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Bid Management</a> <span aria-hidden="true">&rsaquo;</span> <span>Executive Overview</span></nav>

<div class="dash-header">
  <div>
    <p class="muted mt-0" style="margin-bottom:0.15rem;"><span class="live-dot" aria-hidden="true"></span> <%= updatedAtLabel %></p>
    <h1 class="mt-0">Executive Overview</h1>
  </div>
  <form method="get" action="/bids" class="dash-search" role="search">
    <%- include('partials/icon', { name: 'search', size: 16 }) %>
    <input type="text" name="search" placeholder="Search bids, customers, reference numbers">
  </form>
  <div class="row tight">
    <a class="btn secondary" href="/bids/export">Export</a>
    <a class="btn" href="/bids/new">+ Log new tender</a>
  </div>
</div>

<%
  // Division names are free text (admin-configured), so this matches by keyword with a
  // generic fallback for anything not recognized below - "All" deliberately stays icon-less
  // per the reference design.
  function pillIcon(label) {
    const key = label.toLowerCase();
    if (key === 'all') return null;
    if (key === 'no division') return 'grid';
    if (key.includes('server') || key.includes('storage')) return 'box';
    if (key.includes('network')) return 'network';
    if (key.includes('security')) return 'shield';
    if (key.includes('datacenter') || key.includes('facility')) return 'table';
    return 'square';
  }
%>
<div class="division-pills">
  <% data.divisionFilters.forEach(pill => {
       const icon = pillIcon(pill.label);
  %>
    <a class="pill<%= (pill.filterParam || null) === currentDivision ? ' active' : '' %>"
       href="/dashboard<%= pill.filterParam ? '?division=' + encodeURIComponent(pill.filterParam) : '' %>">
      <% if (icon) { %><%- include('partials/icon', { name: icon, size: 15 }) %><% } %>
      <%= pill.label %> <span class="pill-count"><%= pill.closingSoonCount %></span>
    </a>
  <% }) %>
</div>

<%
  const pipelineEtbTotal = data.pipelineByDivision.reduce((sum, r) => sum + Number(r.totalEtb), 0);
  const pipelineUsdTotal = data.pipelineByDivision.reduce((sum, r) => sum + Number(r.totalUsd), 0);
  const missingWithin48h = data.missingReadiness.filter(r => r.closingAt && (new Date(r.closingAt).getTime() - Date.now()) < 48 * 3600 * 1000).length;
  const notStartedCount = data.closingThisWeek.filter(r => r.readinessGaps.includes('Go / no-go')).length;
  const unassignedCount = data.closingThisWeek.filter(r => r.readinessGaps.includes('Owner')).length;
  const behindTarget = data.delaySummary.amberCount + data.delaySummary.redCount + data.delaySummary.criticalCount;

  // Trend lines: data.trends is DashboardService's KpiTrendsDto, already null throughout
  // when no snapshot is ~a week old yet, or when a division pill narrows the view (the
  // stored snapshot is always portfolio-wide - see DashboardKpiSnapshotJob) - trendCount/
  // trendPercent return null in that case and the card just renders without a trend line.
  const hasTrend = !!data.trends.previousSnapshotDate;
  function trendCount(current, previous) {
    if (!hasTrend || previous === null || previous === undefined) return null;
    const delta = current - previous;
    return `${delta > 0 ? '+' : ''}${delta} vs last week`;
  }
  function trendPercent(current, previous) {
    if (!hasTrend || previous === null || previous === undefined) return null;
    const prevNum = Number(previous);
    if (prevNum === 0) return Number(current) === 0 ? '0% vs last week' : null;
    const pct = Math.round(((Number(current) - prevNum) / prevNum) * 100);
    return `${pct > 0 ? '+' : ''}${pct}% vs last week`;
  }
%>
<!-- KPI strip + division pills above stay visible on every tab - the tab panels below only
     split up the long content that used to follow them. Each card carries a fixed category
     color (blue/amber/red/green/purple) always, matching the reference design, rather than
     the old conditional warn/danger state - see docs/UI-UX designs/Executive Overview
     Analytics Dashboard cards.png. -->
<div class="stat-grid kpi-grid" hx-boost="false">
  <a class="stat-card kpi-blue" href="#closing-soon">
    <span class="stat-card-top">
      <span class="stat-icon"><%- include('partials/icon', { name: 'calendar', size: 16 }) %></span>
      <span class="stat-card-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 14 }) %></span>
    </span>
    <span class="stat-label">Closing in 7 days</span>
    <span class="stat-value"><%= data.closingThisWeek.length %></span>
    <span class="muted stat-sub"><%= notStartedCount %> not started &middot; <%= unassignedCount %> unassigned</span>
    <% const t1 = trendCount(data.closingThisWeek.length, data.trends.closingSoonCountPrevious); %>
    <% if (t1) { %><span class="stat-footer-chip"><%- include('partials/icon', { name: 'calendar', size: 13 }) %> <%= t1 %></span><% } %>
  </a>
  <a class="stat-card kpi-amber" href="#closing-soon">
    <span class="stat-card-top">
      <span class="stat-icon"><%- include('partials/icon', { name: 'alert', size: 16 }) %></span>
      <span class="stat-card-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 14 }) %></span>
    </span>
    <span class="stat-label">Bids missing MAF or quote</span>
    <span class="stat-value"><%= data.missingReadiness.length %></span>
    <span class="muted stat-sub"><%= missingWithin48h %> close within 48h</span>
    <% const t2 = trendPercent(data.missingReadiness.length, data.trends.missingReadinessCountPrevious); %>
    <% if (t2) { %><span class="stat-footer-chip <%= t2.startsWith('+') ? 'trend-bad' : (t2.startsWith('-') ? 'trend-good' : '') %>"><%- include('partials/icon', { name: 'trending', size: 13 }) %> <%= t2 %></span><% } %>
  </a>
  <a class="stat-card kpi-red" href="#stuck">
    <span class="stat-card-top">
      <span class="stat-icon"><%- include('partials/icon', { name: 'alert', size: 16 }) %></span>
      <span class="stat-card-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 14 }) %></span>
    </span>
    <span class="stat-label">Behind stage target</span>
    <span class="stat-value"><%= behindTarget %></span>
    <span class="muted stat-sub"><%= data.delaySummary.criticalCount %> critical &middot; <%= data.delaySummary.redCount %> red &middot; <%= data.delaySummary.amberCount %> amber</span>
    <% const t3 = trendPercent(behindTarget, data.trends.behindStageTargetCountPrevious); %>
    <% if (t3) { %><span class="stat-footer-chip <%= t3.startsWith('+') ? 'trend-bad' : (t3.startsWith('-') ? 'trend-good' : '') %>"><%- include('partials/icon', { name: 'trending', size: 13 }) %> <%= t3 %></span><% } %>
  </a>
  <a class="stat-card kpi-green" href="#pipeline-performance">
    <span class="stat-card-top">
      <span class="stat-icon"><%- include('partials/icon', { name: 'trending', size: 16 }) %></span>
      <span class="stat-card-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 14 }) %></span>
    </span>
    <span class="stat-label">Open pipeline</span>
    <span class="stat-value">USD <%= new Intl.NumberFormat('en-US').format(pipelineUsdTotal) %></span>
    <span class="muted stat-sub"><%= formatMoney(pipelineEtbTotal) %> &middot; <%= data.unpricedBidCount %> bids unpriced</span>
    <% const t4 = trendPercent(pipelineUsdTotal, data.trends.openPipelineUsdPrevious); %>
    <% if (t4) { %><span class="stat-footer-chip"><%- include('partials/icon', { name: 'trending', size: 13 }) %> <%= t4 %></span><% } %>
  </a>
  <a class="stat-card kpi-purple" href="#bonds-outstanding">
    <span class="stat-card-top">
      <span class="stat-icon"><%- include('partials/icon', { name: 'shield', size: 16 }) %></span>
      <span class="stat-card-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 14 }) %></span>
    </span>
    <span class="stat-label">Bid bonds outstanding</span>
    <span class="stat-value"><%= formatMoney(data.outstandingBondTotalEtb) %></span>
    <span class="muted stat-sub"><%= data.bondsExpiringWithin90DaysCount %> expires within 90 days</span>
    <% const t5 = trendPercent(data.outstandingBondTotalEtb, data.trends.bidBondsOutstandingEtbPrevious); %>
    <% if (t5) { %><span class="stat-footer-chip <%= t5.startsWith('+') ? 'trend-bad' : (t5.startsWith('-') ? 'trend-good' : '') %>"><%- include('partials/icon', { name: 'trending', size: 13 }) %> <%= t5 %></span><% } %>
  </a>
  <a class="stat-card kpi-blue" href="#deal-regs">
    <span class="stat-card-top">
      <span class="stat-icon"><%- include('partials/icon', { name: 'repeat', size: 16 }) %></span>
      <span class="stat-card-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 14 }) %></span>
    </span>
    <span class="stat-label">Deal regs expiring</span>
    <span class="stat-value"><%= data.expiringDealRegistrations.length %></span>
    <span class="muted stat-sub">next 30 days</span>
    <% const t6 = trendCount(data.expiringDealRegistrations.length, data.trends.dealRegsExpiringCountPrevious); %>
    <% if (t6) { %><span class="stat-footer-chip"><%- include('partials/icon', { name: 'calendar', size: 13 }) %> <%= t6 %></span><% } %>
  </a>
</div>

<nav class="anchor-nav" role="tablist" aria-label="Section navigation">
  <a href="#overview" id="tab-overview" role="tab" aria-controls="overview">Overview</a>
  <a href="#closing-readiness" id="tab-closing-readiness" role="tab" aria-controls="closing-readiness">Closing &amp; Readiness</a>
  <a href="#delays" id="tab-delays" role="tab" aria-controls="delays">Delays</a>
  <a href="#pipeline-performance" id="tab-pipeline-performance" role="tab" aria-controls="pipeline-performance">Pipeline &amp; Performance</a>
  <a href="#bonds-deal-regs" id="tab-bonds-deal-regs" role="tab" aria-controls="bonds-deal-regs">Bonds &amp; Deal Regs</a>
</nav>

<section id="overview" class="tab-panel" role="tabpanel" aria-labelledby="tab-overview" tabindex="-1">
  <div class="card pipeline-kanban-card">
    <div class="row top" style="justify-content:space-between;">
      <div>
        <h2 class="mt-0"><%- include('partials/icon', { name: 'trending' }) %> Bid pipeline</h2>
        <p class="muted mt-0">Track your opportunities from opportunity to award</p>
      </div>
      <div class="row tight" id="kanban-filters" role="group" aria-label="Filter pipeline">
        <button type="button" class="pill active" data-filter="all">All <span class="pill-count"><%= pipelineKanban.allCount %></span></button>
        <button type="button" class="pill" data-filter="open">Open <span class="pill-count"><%= pipelineKanban.openCount %></span></button>
        <button type="button" class="pill" data-filter="won">Won <span class="pill-count"><%= pipelineKanban.wonCount %></span></button>
        <button type="button" class="pill" data-filter="lost">Lost <span class="pill-count"><%= pipelineKanban.lostCount %></span></button>
      </div>
    </div>

    <%
      const STAGE_EMPTY = {
        preparing: { icon: 'clipboard', helper: 'Move opportunities here as you start preparing.' },
        submitted: { icon: 'send', helper: 'Submit your proposals to move forward.' },
        evaluation: { icon: 'search', helper: 'Track evaluation progress and feedback.' },
        won: { icon: 'trophy', helper: 'Great opportunities await!' },
      };
    %>
    <div class="row top mt-2" style="align-items:stretch;">
      <div class="kanban-board" style="flex:4; min-width:0;">
        <% pipelineKanban.columns.forEach((col, colIndex) => {
          const stageKey = col.stage.toLowerCase();
          const emptyState = STAGE_EMPTY[stageKey] || { icon: 'box', helper: 'Move opportunities here as you progress.' };
          const chainClass = colIndex === 0 ? ' chain-start' : (colIndex === pipelineKanban.columns.length - 1 ? ' chain-end' : '');
        %>
          <div class="kanban-column stage-<%= stageKey %><%= chainClass %>" data-stage="<%= stageKey %>">
            <div class="kanban-column-header">
              <span><%= col.stage %></span>
              <span class="kanban-column-count"><%= col.count %></span>
            </div>
            <div class="kanban-column-body">
              <% if (col.bids.length === 0) { %>
                <div class="kanban-empty">
                  <span class="kanban-empty-icon"><%- include('partials/icon', { name: emptyState.icon, size: 22 }) %></span>
                  <p><%= stageKey === 'won' ? 'No won deals yet' : 'No bids in this stage' %></p>
                  <p class="muted" style="font-size:0.75rem;"><%= emptyState.helper %></p>
                </div>
              <% } else { %>
                <ul class="pipeline-list">
                <% col.bids.forEach(b => {
                  const cardLabel = (b.organizationName ? b.organizationName + ' - ' : '') + b.title;
                %>
                  <li>
                    <a href="/bids/<%= b.id %>" title="<%= cardLabel %>">
                      <strong class="pipeline-card-title"><%= cardLabel %></strong>
                      <span class="muted"><%= b.organizationName || 'No customer' %> &middot; <%= b.closingAt ? formatDate(b.closingAt) : 'No closing date' %></span>
                    </a>
                  </li>
                <% }) %>
                </ul>
                <% if (col.count > col.bids.length) { %>
                  <a class="view-all" href="/bids?status=<%= col.primaryStatus %>">View all <%= col.count %> &rarr;</a>
                <% } %>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="pipeline-donut-wrap" style="flex:0 0 10rem; min-width:10rem;">
        <h3 class="mt-0" style="font-size:0.95rem;">Pipeline distribution</h3>
        <%
          const donutColors = { Identified: 'var(--accent)', Preparing: '#5b9bf0', Submitted: '#8b5cf6', Evaluation: 'var(--warn)', Won: 'var(--ok)' };
          const donutTotal = Math.max(1, data.lifecycleStages.reduce((s, r) => s + r.bidCount, 0));
          const donutR = 60, donutCirc = 2 * Math.PI * donutR;
          let donutOffset = 0;
        %>
        <svg viewBox="0 0 160 160" class="donut-chart" role="img" aria-label="Pipeline distribution by stage">
          <circle cx="80" cy="80" r="<%= donutR %>" fill="none" stroke="var(--border)" stroke-width="18"/>
          <% data.lifecycleStages.forEach(stage => {
            const segLen = (stage.bidCount / donutTotal) * donutCirc;
            if (stage.bidCount > 0) { %>
            <circle cx="80" cy="80" r="<%= donutR %>" fill="none" stroke="<%= donutColors[stage.stageLabel] %>" stroke-width="18"
                    stroke-dasharray="<%= segLen %> <%= donutCirc - segLen %>" stroke-dashoffset="<%= -donutOffset %>" transform="rotate(-90 80 80)"/>
            <% }
            donutOffset += segLen;
          %>
          <% }) %>
          <text x="80" y="76" text-anchor="middle" class="donut-total"><%= data.lifecycleStages.reduce((s, r) => s + r.bidCount, 0) %></text>
          <text x="80" y="94" text-anchor="middle" class="donut-total-label">Total bids</text>
        </svg>
        <div class="donut-legend">
          <% data.lifecycleStages.forEach(stage => { %>
            <div class="donut-legend-row">
              <span class="donut-dot" style="background:<%= donutColors[stage.stageLabel] %>;"></span>
              <span><%= stage.stageLabel %></span>
              <strong><%= stage.bidCount %></strong>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
    <p class="muted mt-1" id="kanban-lost-note" hidden>Lost/dropped/cancelled bids aren't shown on the live pipeline board - <a href="/bids?status=LOST">see them in the full bid list &rarr;</a></p>
  </div>

  <div class="row top mt-2">
    <div class="col" style="flex:1; min-width:20rem;">
      <h2 class="mt-1"><%- include('partials/icon', { name: 'alert' }) %> Priority actions</h2>
      <% if (priorityActions.length === 0) { %>
        <p class="muted">Nothing needs attention right now.</p>
      <% } else { %>
        <div class="priority-list">
          <% priorityActions.forEach(action => { %>
            <a class="priority-item <%= action.urgency %>" href="<%= action.href %>">
              <span class="priority-item-icon"><%- include('partials/icon', { name: action.icon, size: 18 }) %></span>
              <span class="priority-item-body">
                <span class="priority-item-title"><%= action.title %></span>
                <span class="priority-item-detail"><%= action.detail %></span>
              </span>
              <span class="priority-item-badge badge <%= action.urgency === 'urgent' ? 'lost' : (action.urgency === 'high' ? 'review' : 'active') %>"><%= action.urgency %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="col" style="flex:1; min-width:20rem;">
      <h2 class="mt-1"><%- include('partials/icon', { name: 'clock' }) %> Recent activity</h2>
      <div class="card">
        <% if (data.recentActivity.length === 0) { %>
          <p class="muted">No activity recorded yet.</p>
        <% } else { %>
          <div class="activity-timeline">
            <% data.recentActivity.forEach(entry => { %>
              <% const entryTitle = (entry.organizationName ? entry.organizationName + ' - ' : '') + entry.bidTitle; %>
              <div class="activity-timeline-item">
                <span class="activity-timeline-dot"></span>
                <div class="activity-timeline-body">
                  <a class="activity-timeline-title" href="/bids/<%= entry.bidId %>" title="<%= entryTitle %>"><%= entryTitle %></a>
                  <div class="muted activity-timeline-meta"><%= entry.message %> &middot; <%= formatDate(entry.occurredAt) %></div>
                </div>
              </div>
            <% }) %>
          </div>
          <a class="view-all" href="/dashboard/activity<%= currentDivision ? '?division=' + encodeURIComponent(currentDivision) : '' %>">View all <%= data.recentActivityTotalCount %> &rarr;</a>
        <% } %>
      </div>
    </div>

    <div class="col promo-card" style="flex:1; min-width:18rem;">
      <svg viewBox="0 0 160 100" class="promo-illustration" aria-hidden="true">
        <polygon points="5,95 55,30 90,68 108,45 155,95" fill="var(--accent-bg)" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"/>
        <polygon points="65,95 108,45 155,95" fill="var(--bg-alt)" stroke="var(--border)" stroke-width="2" stroke-linejoin="round"/>
        <line x1="108" y1="45" x2="118" y2="30" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/>
        <polygon points="118,30 135,36 118,42" fill="var(--danger)"/>
      </svg>
      <h3 class="mt-1">Stay ahead of your opportunities</h3>
      <p class="muted">Keep your pipeline healthy, meet deadlines and win more bids.</p>
      <a class="btn w-auto" href="#pipeline-performance">View full pipeline &rarr;</a>
    </div>
  </div>
</section>

<script>
  (function () {
    var filterBar = document.getElementById('kanban-filters');
    if (!filterBar) return;
    var buttons = filterBar.querySelectorAll('[data-filter]');
    var columns = document.querySelectorAll('.kanban-column');
    var lostNote = document.getElementById('kanban-lost-note');

    function applyFilter(filter) {
      var visible = [];
      columns.forEach(function (col) {
        var stage = col.getAttribute('data-stage');
        var show = filter === 'all' || (filter === 'open' && stage !== 'won') || (filter === 'won' && stage === 'won');
        col.hidden = !show;
        col.classList.remove('chain-start', 'chain-end');
        if (show) visible.push(col);
      });
      // The interlocking chevron chain only has a flat left/right edge at whichever columns
      // are currently first/last among the VISIBLE set - recomputed on every filter change
      // (hiding "Won" shifts the flat-right edge onto whatever stage is now last, etc.).
      if (visible.length) {
        visible[0].classList.add('chain-start');
        visible[visible.length - 1].classList.add('chain-end');
      }
      lostNote.hidden = filter !== 'lost';
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.toggle('active', b === btn); });
        applyFilter(btn.getAttribute('data-filter'));
      });
    });
  })();
</script>

<section id="closing-readiness" class="tab-panel" role="tabpanel" aria-labelledby="tab-closing-readiness" tabindex="-1">
  <div class="section-header section-header-row">
    <div class="section-header-icon"><%- include('partials/icon', { name: 'calendar', size: 22 }) %></div>
    <div class="section-header-text">
      <h2 class="mt-0">Closing &amp; Readiness</h2>
      <p class="muted mt-0">Monitor submission deadlines, resolve readiness gaps, and track clarifications.</p>
    </div>
    <div class="section-header-meta">
      <span class="section-updated"><%- include('partials/icon', { name: 'calendar', size: 15 }) %> <span>Last updated<br><strong><%= updatedAtLabel %></strong></span></span>
      <a href="#closing-readiness" class="btn w-auto" onclick="location.reload(); return false;"><%- include('partials/icon', { name: 'repeat', size: 15 }) %> Refresh</a>
    </div>
  </div>

  <%
    const readinessGapTotal = data.missingReadiness.reduce((sum, r) => sum + r.readinessGaps.length, 0);
    const unassignedReadinessCount = data.missingReadiness.filter(r => !r.ownerLabel).length;
    const criticalRedDelayCount = data.delaySummary.criticalCount + data.delaySummary.redCount;
  %>
  <div class="stat-grid chevron-stat-grid" hx-boost="false">
    <a class="stat-card stat-blue" href="#closing-soon">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'calendar' }) %></span>
        <span class="stat-label">Closing Soon</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= data.closingThisWeek.length %></span>
      <span class="muted" style="font-size:0.78rem;">Within next 7 days</span>
    </a>
    <a class="stat-card stat-orange" href="#readiness-gaps-tab">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'alert' }) %></span>
        <span class="stat-label">Readiness Gaps</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= readinessGapTotal %></span>
      <span class="muted" style="font-size:0.78rem;">Across <%= data.missingReadiness.length %> bids</span>
    </a>
    <a class="stat-card stat-green" href="#readiness-gaps-tab">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'user' }) %></span>
        <span class="stat-label">Unassigned</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= unassignedReadinessCount %></span>
      <span class="muted" style="font-size:0.78rem;">Among bids missing readiness</span>
    </a>
    <a class="stat-card stat-red" href="#delays">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'alert' }) %></span>
        <span class="stat-label">Critical/Red Delays</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= criticalRedDelayCount %></span>
      <span class="muted" style="font-size:0.78rem;">Stage-target critical or red</span>
    </a>
  </div>

  <nav class="anchor-nav sub-nav" role="tablist" aria-label="Closing &amp; Readiness sections">
    <a href="#closing-schedule" id="tab-closing-schedule" role="tab" aria-controls="closing-schedule"><%- include('partials/icon', { name: 'calendar', size: 16 }) %> Closing Schedule</a>
    <a href="#readiness-gaps-tab" id="tab-readiness-gaps-tab" role="tab" aria-controls="readiness-gaps-tab"><%- include('partials/icon', { name: 'alert', size: 16 }) %> Readiness Gaps</a>
    <a href="#clarifications-tab" id="tab-clarifications-tab" role="tab" aria-controls="clarifications-tab"><%- include('partials/icon', { name: 'clock', size: 16 }) %> Clarifications</a>
  </nav>

  <section id="closing-schedule" class="tab-panel" role="tabpanel" aria-labelledby="tab-closing-schedule" tabindex="-1">
    <%# id="closing-soon" preserves the page-level "Closing in 7 days"/"Missing MAF" KPI cards' and the Priority Actions list's existing links into this now-nested sub-tab - see buildPriorityActions in dashboard.js and the stat-grid above. %>
    <span id="closing-soon"></span>
    <% if (closingScheduleRows.length === 0) { %>
      <p class="muted mt-2">Nothing closing in the next 14 days.</p>
    <% } else { %>
    <div class="schedule-toolbar" id="schedule-toolbar">
      <div class="row tight schedule-toolbar-group" role="group" aria-label="Quick date range">
        <button type="button" class="pill" data-range="today" data-closing-to="<%= dateRanges.closingToday.closingTo %>">Today</button>
        <button type="button" class="pill" data-range="3" data-closing-to="<%= dateRanges.closingNext3Days.closingTo %>">Next 3 Days</button>
        <button type="button" class="pill active" data-range="7" data-closing-to="<%= dateRanges.closingThisWeek.closingTo %>">Next 7 Days</button>
        <button type="button" class="pill" data-range="14" data-closing-to="<%= dateRanges.closingNextWeek.closingTo %>">14 Days</button>
      </div>
      <div class="row tight schedule-toolbar-group">
        <input type="search" id="schedule-search" placeholder="Search bids, customers..." class="w-auto">
        <select id="schedule-division-filter" class="w-auto">
          <option value="">All divisions</option>
          <% closingScheduleDivisions.forEach(d => { %><option value="<%= d %>"><%= d %></option><% }) %>
        </select>
        <select id="schedule-owner-filter" class="w-auto">
          <option value="">All owners</option>
          <option value="Unassigned">Unassigned</option>
          <% closingScheduleOwners.forEach(o => { %><option value="<%= o %>"><%= o %></option><% }) %>
        </select>
        <select id="schedule-readiness-filter" class="w-auto">
          <option value="">All readiness</option>
          <option value="ready">Ready</option>
          <option value="gaps">Has gaps</option>
        </select>
        <button type="button" class="secondary w-auto" id="schedule-sort-toggle" data-dir="asc">Sort: Closing date &uarr;</button>
      </div>
    </div>

    <%
      const totalScheduleDates = closingScheduleByDate.length;
    %>
    <div class="schedule-summary-card">
      <span class="schedule-summary-icon"><%- include('partials/icon', { name: 'calendar', size: 18 }) %></span>
      <div class="schedule-summary-text">
        <strong><span id="schedule-date-count"><%= totalScheduleDates %></span> closing <span id="schedule-date-count-label"><%= totalScheduleDates === 1 ? 'date' : 'dates' %></span></strong>
        <%# Matches whichever quick-range pill is active by default ("Next 7 Days"), not always the
           full 14-day window - kept in sync with the active pill client-side below, so this never
           re-advertises a wider range than what's actually shown/filtered above it. %>
        <a class="view-all" id="schedule-view-all" href="/bids?<%= new URLSearchParams({ closingFrom: dateRanges.closingThisWeek.closingFrom, closingTo: dateRanges.closingThisWeek.closingTo }).toString() %>">Open full 7-day range in bid list &rarr;</a>
      </div>
    </div>

    <div id="schedule-groups">
      <% closingScheduleByDate.forEach((group, groupIndex) => {
        const isToday = group.relative === 'Today';
        const isTomorrow = group.relative === 'Tomorrow';
        const chipClass = isToday ? 'lost' : (isTomorrow ? 'review' : '');
        const chipLabel = isToday ? 'Due Today' : (isTomorrow ? 'Due Tomorrow' : (group.relative ? 'Due ' + group.relative : null));
        const dateLabel = isToday ? 'Closing today' : (isTomorrow ? 'Closing tomorrow' : (group.relative ? group.relative.charAt(0).toUpperCase() + group.relative.slice(1) : group.label));
        const subIcon = isToday ? 'clock' : 'calendar';
        const subText = isToday ? 'Today' : (isTomorrow ? 'Tomorrow' : `${group.weekday} ${group.dayMonth}`);
      %>
      <div class="schedule-date-group<%= isToday ? ' is-today' : '' %>" data-group data-group-key="<%= group.key %>">
        <details<%= groupIndex === 0 ? ' open' : '' %>>
          <summary class="schedule-date-summary">
            <div class="schedule-date-badge">
              <span class="schedule-date-weekday"><%= group.weekday %></span>
              <span class="schedule-date-day"><%= group.dayMonth %></span>
            </div>
            <span class="badge bid-count-badge" data-group-count><%= group.rows.length %> bid<%= group.rows.length === 1 ? '' : 's' %></span>
            <div class="schedule-date-info">
              <strong><%= dateLabel %></strong>
              <span class="muted schedule-date-sub"><%- include('partials/icon', { name: subIcon, size: 13 }) %> <%= subText %></span>
            </div>
            <div class="schedule-date-counts">
              <span class="readiness-pill ready<%= group.readyCount === 0 ? ' zero' : '' %>" data-group-ready><%- include('partials/icon', { name: 'check', size: 13 }) %> <%= group.readyCount %> ready</span>
              <span class="readiness-pill gap<%= group.gapCount === 0 ? ' zero' : '' %>" data-group-gap><%- include('partials/icon', { name: 'alert', size: 13 }) %> <%= group.gapCount %> incomplete</span>
              <span class="readiness-pill critical<%= group.criticalCount === 0 ? ' zero' : '' %>" data-group-critical><%- include('partials/icon', { name: 'alert', size: 13 }) %> <%= group.criticalCount %> critical</span>
            </div>
            <span class="schedule-date-chevron" aria-hidden="true"><%- include('partials/icon', { name: 'chevron-right', size: 16 }) %></span>
          </summary>
          <div class="schedule-rows">
            <% group.rows.forEach(row => { %>
            <div class="schedule-row" data-row
                 data-closing-at="<%= row.closingAt %>"
                 data-search="<%= (row.title + ' ' + row.organizationName).toLowerCase() %>"
                 data-division="<%= row.divisionNames.join('|') %>"
                 data-owner="<%= row.ownerLabel || 'Unassigned' %>"
                 data-readiness="<%= row.readinessGaps.length === 0 ? 'ready' : 'gaps' %>"
                 data-critical="<%= row.redFlag %>">
              <div class="schedule-row-time">
                <strong><%= new Date(row.closingAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Africa/Addis_Ababa' }) %></strong>
                <% if (chipLabel) { %><span class="badge <%= chipClass %>"><%= chipLabel %></span><% } %>
              </div>
              <div class="schedule-row-main">
                <a href="/bids/<%= row.bidId %>"><%= row.title %></a>
                <div class="muted" style="font-size:0.8rem;"><%= row.organizationName %></div>
              </div>
              <div class="schedule-row-meta">
                <span class="row tight"><%- include('partials/icon', { name: 'building', size: 15 }) %> <%= row.divisionNames.length ? row.divisionNames.join(', ') : 'Not assigned' %></span>
                <span class="row tight"><%- include('partials/icon', { name: 'user', size: 15 }) %> <%= row.ownerLabel || 'Unassigned' %></span>
              </div>
              <div class="schedule-row-readiness">
                <% if (row.readinessGaps.length === 0) { %><span class="badge won">Ready</span>
                <% } else { %><span class="badge gap-badge"><%= row.readinessGaps.length %> gap<%= row.readinessGaps.length === 1 ? '' : 's' %></span><% } %>
              </div>
              <div class="schedule-row-bond muted">
                <% if (Number(row.bidBondAmountEtb) > 0) { %><%= formatMoney(row.bidBondAmountEtb, 'ETB') %><% } %>
                <% if (Number(row.bidBondAmountUsd) > 0) { %><%= formatMoney(row.bidBondAmountUsd, 'USD') %><% } %>
                <% if (Number(row.bidBondAmountEtb) === 0 && Number(row.bidBondAmountUsd) === 0) { %>-<% } %>
              </div>
              <a class="btn secondary w-auto btn-xs" href="/bids/<%= row.bidId %>">View</a>
            </div>
            <% }) %>
          </div>
        </details>
      </div>
      <% }) %>
    </div>
    <p class="muted mt-1" id="schedule-empty" hidden>No bids match the current filters.</p>

    <script>
      // Pure client-side filtering/sorting over the already-rendered rows above - every row
      // carries its own closing time/search text/division/owner/readiness as data-* attributes,
      // so narrowing the view needs no page reload or extra fetch. "Today/Next 3/7/14 Days" are
      // cumulative upper bounds (not exclusive buckets), matching how the ranges read in the UI.
      (function () {
        var toolbar = document.getElementById('schedule-toolbar');
        if (!toolbar) return;
        var rangeButtons = toolbar.querySelectorAll('[data-range]');
        var search = document.getElementById('schedule-search');
        var divisionFilter = document.getElementById('schedule-division-filter');
        var ownerFilter = document.getElementById('schedule-owner-filter');
        var readinessFilter = document.getElementById('schedule-readiness-filter');
        var sortToggle = document.getElementById('schedule-sort-toggle');
        var groupsContainer = document.getElementById('schedule-groups');
        var emptyMsg = document.getElementById('schedule-empty');
        var viewAllLink = document.getElementById('schedule-view-all');
        var dateCountEl = document.getElementById('schedule-date-count');
        var dateCountLabelEl = document.getElementById('schedule-date-count-label');
        var activeRange = '7';
        var RANGE_HOURS = { today: 24, '3': 72, '7': 168, '14': 336 };
        var RANGE_LABEL = { today: "today's", '3': "next 3 days'", '7': 'full 7-day', '14': 'full 14-day' };

        function applyFilters() {
          var now = Date.now();
          var rangeHours = RANGE_HOURS[activeRange] || RANGE_HOURS['14'];
          var searchText = search.value.trim().toLowerCase();
          var division = divisionFilter.value;
          var owner = ownerFilter.value;
          var readiness = readinessFilter.value;
          var anyVisible = false;

          var visibleGroupCount = 0;

          groupsContainer.querySelectorAll('[data-group]').forEach(function (group) {
            var groupHasVisible = false;
            var readyCount = 0, gapCount = 0, criticalCount = 0;
            group.querySelectorAll('[data-row]').forEach(function (row) {
              var hoursUntil = (new Date(row.getAttribute('data-closing-at')).getTime() - now) / 3600000;
              var matches = hoursUntil <= rangeHours
                && (!searchText || row.getAttribute('data-search').indexOf(searchText) !== -1)
                && (!division || row.getAttribute('data-division').split('|').indexOf(division) !== -1)
                && (!owner || row.getAttribute('data-owner') === owner)
                && (!readiness || row.getAttribute('data-readiness') === readiness);
              row.hidden = !matches;
              if (matches) {
                groupHasVisible = true; anyVisible = true;
                if (row.getAttribute('data-readiness') === 'ready') { readyCount++; } else { gapCount++; }
                if (row.getAttribute('data-critical') === 'true') { criticalCount++; }
              }
            });
            group.hidden = !groupHasVisible;
            if (groupHasVisible) { visibleGroupCount++; }
            var countEl = group.querySelector('[data-group-count]');
            if (countEl) {
              countEl.textContent = (readyCount + gapCount) + ' bid' + (readyCount + gapCount === 1 ? '' : 's');
            }
            // Re-derives each pill's "filled vs. zero-count outline" look (see the
            // #closing-readiness .readiness-pill.zero CSS rule) as counts change, not just the
            // number inside it - a pill that drops to 0 after filtering should look like the
            // other zero-count pills, not stay visually "active" with a 0 in it.
            // Label text must match the server-rendered pill (dashboard.ejs's own markup
            // above) - "incomplete" rather than "N gap(s)", since this count is bids-with-gaps,
            // not a count of individual readiness gaps (that's the per-bid badge further down).
            [['ready', readyCount, 'ready'], ['gap', gapCount, 'incomplete'], ['critical', criticalCount, 'critical']]
              .forEach(function (entry) {
                var pillEl = group.querySelector('[data-group-' + entry[0] + ']');
                if (!pillEl) return;
                pillEl.classList.toggle('zero', entry[1] === 0);
                var icon = pillEl.querySelector('svg');
                pillEl.textContent = ' ' + entry[1] + ' ' + entry[2];
                if (icon) { pillEl.insertBefore(icon, pillEl.firstChild); }
              });
          });

          emptyMsg.hidden = anyVisible;
          if (dateCountEl) { dateCountEl.textContent = visibleGroupCount; }
          if (dateCountLabelEl) { dateCountLabelEl.textContent = visibleGroupCount === 1 ? 'date' : 'dates'; }
        }

        // Keeps the "Open ... range in bid list" link below the schedule matching whichever
        // quick-range pill is active, instead of it always pointing at the full 14-day window
        // regardless of what's currently filtered above it - closingFrom (today) never changes
        // between ranges, only closingTo does, so only that query param needs rebuilding.
        function syncViewAllLink(btn) {
          if (!viewAllLink) return;
          var url = new URL(viewAllLink.href, window.location.origin);
          url.searchParams.set('closingTo', btn.getAttribute('data-closing-to'));
          viewAllLink.href = url.toString();
          var label = RANGE_LABEL[btn.getAttribute('data-range')] || RANGE_LABEL['14'];
          viewAllLink.textContent = 'Open ' + label + ' range in bid list →';
        }

        rangeButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            rangeButtons.forEach(function (b) { b.classList.toggle('active', b === btn); });
            activeRange = btn.getAttribute('data-range');
            applyFilters();
            syncViewAllLink(btn);
          });
        });
        search.addEventListener('input', applyFilters);
        divisionFilter.addEventListener('change', applyFilters);
        ownerFilter.addEventListener('change', applyFilters);
        readinessFilter.addEventListener('change', applyFilters);

        sortToggle.addEventListener('click', function () {
          var dir = sortToggle.getAttribute('data-dir') === 'asc' ? 'desc' : 'asc';
          sortToggle.setAttribute('data-dir', dir);
          sortToggle.textContent = 'Sort: Closing date ' + (dir === 'asc' ? '↑' : '↓');
          var groups = Array.prototype.slice.call(groupsContainer.querySelectorAll('[data-group]'));
          groups.sort(function (a, b) {
            var ka = a.getAttribute('data-group-key'), kb = b.getAttribute('data-group-key');
            return dir === 'asc' ? ka.localeCompare(kb) : kb.localeCompare(ka);
          });
          groups.forEach(function (g) { groupsContainer.appendChild(g); });
        });

        applyFilters();
      })();
    </script>
    <% } %>
  </section>

  <section id="readiness-gaps-tab" class="tab-panel" role="tabpanel" aria-labelledby="tab-readiness-gaps-tab" tabindex="-1">
    <h2 id="readiness-gaps" class="mt-1"><%- include('partials/icon', { name: 'alert' }) %> Bid readiness gaps</h2>
    <p class="muted mt-0">Open bids still missing a MAF or vendor quote, regardless of closing date</p>
    <% if (data.missingReadiness.length === 0) { %>
      <p class="muted">No readiness gaps right now.</p>
    <% } else { %>
    <div class="table-scroll">
    <table>
      <thead><tr><th>Bid</th><th>Division</th><th>Gaps</th><th>Owner</th><th>Closing</th></tr></thead>
      <tbody>
        <% data.missingReadiness.forEach(row => { %>
          <tr onclick="window.location='/bids/<%= row.bidId %>'" style="cursor:pointer;">
            <td>
              <a href="/bids/<%= row.bidId %>"><%= row.title %></a>
              <div class="muted" style="font-size:0.8rem;"><%= row.organizationName %></div>
            </td>
            <td><%= row.divisionNames.length ? row.divisionNames.join(', ') : '-' %></td>
            <td><% row.readinessGaps.forEach(gap => { %><span class="badge gap-badge"><%= gap %></span><% }) %></td>
            <td><%= row.ownerLabel || 'Unassigned' %></td>
            <td class="muted"><%= row.closingAt ? formatDate(row.closingAt) : 'No closing date' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </section>

  <section id="clarifications-tab" class="tab-panel" role="tabpanel" aria-labelledby="tab-clarifications-tab" tabindex="-1">
    <h2 class="mt-1"><%- include('partials/icon', { name: 'clock' }) %> Upcoming clarification deadlines</h2>
    <div class="card">
      <% if (data.upcomingClarifications.length === 0) { %><p class="muted">None upcoming.</p><% } %>
      <% clarificationGroups.forEach(group => { %>
        <div class="subgroup-heading"><%= group.label %></div>
        <% group.rows.forEach(row => { %>
          <div class="checklist-item">
            <a href="/bids/<%= row.bidId %>"><%= row.title %></a> - <%= row.organizationName %>
            <% if (row.divisionNames.length) { %><span class="badge"><%= row.divisionNames.join(', ') %></span><% } %>
            <span class="muted"><%= formatDateTime(row.clarificationDeadline) %></span>
          </div>
        <% }) %>
      <% }) %>
    </div>
  </section>
</section>

<section id="delays" class="tab-panel" role="tabpanel" aria-labelledby="tab-delays" tabindex="-1">
  <%
    const segTotal = data.delaySummary.criticalCount + data.delaySummary.redCount + data.delaySummary.amberCount + data.delaySummary.greenCount;
    const segPct = (n) => segTotal > 0 ? (n / segTotal * 100) : 0;
    // Which of Critical/Red/Amber has the most bids right now - drives both the delay-list
    // header below ("<Level> delays (N)") and the donut's center reading, same as the
    // reference design highlighting whichever bucket is actually the problem rather than
    // always defaulting to "Critical" - see docs/UI-UX designs/Bid Management Delays Dashboard.png.
    const delayLevels = [
      { key: 'CRITICAL', label: 'Critical', count: data.delaySummary.criticalCount },
      { key: 'RED', label: 'Red', count: data.delaySummary.redCount },
      { key: 'AMBER', label: 'Amber', count: data.delaySummary.amberCount },
    ];
    const dominantDelay = delayLevels.reduce((max, l) => l.count > max.count ? l : max, delayLevels[0]);
    const delayRows = data.delaySummary.topDelayed.filter(r => r.indicatorLevel === dominantDelay.key);
    const entityTypeIcon = { LOT: 'clipboard', CONTRACT: 'send', LOGISTICS: 'box', OPPORTUNITY: 'trending', DEAL_REGISTRATION: 'repeat' };
  %>
  <div class="row top">
    <div class="col" style="flex:2; min-width:32rem;">
      <div class="section-header-row">
        <div class="section-header-icon section-header-icon-danger"><%- include('partials/icon', { name: 'alert', size: 22 }) %></div>
        <div class="section-header-text">
          <h2 id="stuck" class="mt-0">Where deals are stuck</h2>
          <p class="muted mt-0">Identify bids exceeding their target stage duration and unblock the next action.</p>
        </div>
      </div>

      <div class="stat-grid delay-stat-grid" hx-boost="false">
        <div class="stat-card delay-stat critical">
          <span class="stat-icon"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span>
          <span class="stat-value"><%= data.delaySummary.criticalCount %></span>
          <span class="stat-label">Critical</span>
          <span class="muted stat-sub">Deals beyond target stage</span>
        </div>
        <div class="stat-card delay-stat red">
          <span class="stat-icon"><%- include('partials/icon', { name: 'alert-circle', size: 18 }) %></span>
          <span class="stat-value"><%= data.delaySummary.redCount %></span>
          <span class="stat-label">Red</span>
          <span class="muted stat-sub">Overdue or high risk</span>
        </div>
        <div class="stat-card delay-stat amber">
          <span class="stat-icon"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span>
          <span class="stat-value"><%= data.delaySummary.amberCount %></span>
          <span class="stat-label">Amber</span>
          <span class="muted stat-sub">At risk of delay</span>
        </div>
        <div class="stat-card delay-stat green">
          <span class="stat-icon"><%- include('partials/icon', { name: 'check', size: 18 }) %></span>
          <span class="stat-value"><%= data.delaySummary.greenCount %></span>
          <span class="stat-label">On track</span>
          <span class="muted stat-sub">Within target duration</span>
        </div>
        <div class="stat-card delay-stat stale">
          <span class="stat-icon"><%- include('partials/icon', { name: 'clock', size: 18 }) %></span>
          <span class="stat-value"><%= data.delaySummary.staleCount %></span>
          <span class="stat-label">Stale</span>
          <span class="muted stat-sub">No recent activity</span>
        </div>
      </div>

      <div class="segmented-bar mt-2">
        <% if (data.delaySummary.criticalCount > 0) { %><div class="segment critical" style="width:<%= segPct(data.delaySummary.criticalCount) %>%;"></div><% } %>
        <% if (data.delaySummary.redCount > 0) { %><div class="segment red" style="width:<%= segPct(data.delaySummary.redCount) %>%;"></div><% } %>
        <% if (data.delaySummary.amberCount > 0) { %><div class="segment amber" style="width:<%= segPct(data.delaySummary.amberCount) %>%;"></div><% } %>
        <% if (data.delaySummary.greenCount > 0) { %><div class="segment green" style="width:<%= segPct(data.delaySummary.greenCount) %>%;"></div><% } %>
      </div>
      <div class="row" style="justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <div class="row tight mt-1" style="font-size:0.82rem;">
          <span><span class="status-dot" style="background:var(--danger);"></span> Critical <%= data.delaySummary.criticalCount %></span>
          <span><span class="status-dot" style="background:var(--danger);opacity:0.6;"></span> Red <%= data.delaySummary.redCount %></span>
          <span><span class="status-dot" style="background:var(--warn);"></span> Amber <%= data.delaySummary.amberCount %></span>
          <span><span class="status-dot" style="background:var(--ok);"></span> On track <%= data.delaySummary.greenCount %></span>
        </div>
        <a class="view-all" href="/delays">Delays board &rarr;</a>
      </div>
      <p class="muted mt-1" style="font-size:0.82rem;">Stale <%= data.delaySummary.staleCount %></p>

      <div class="row mt-3" style="justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <h3 class="mt-0"><%= dominantDelay.label %> delays (<%= dominantDelay.count %>)</h3>
        <% if (delayRows.length > 0) { %>
          <div class="row tight">
            <label class="muted" for="delay-sort" style="font-size:0.82rem;">Sort by</label>
            <select id="delay-sort" class="w-auto">
              <option value="days">Longest delay</option>
              <option value="closing">Closing soonest</option>
            </select>
          </div>
        <% } %>
      </div>

      <% if (delayRows.length === 0) { %>
        <p class="muted">Nothing behind target right now.</p>
      <% } else { %>
        <div class="stack delay-list" id="delay-list">
          <% delayRows.forEach(row => {
            const ringPct = row.percentUsed !== null ? Math.min(100, Math.max(0, row.percentUsed)) : 0;
            const ringR = 26, ringCirc = 2 * Math.PI * ringR;
            const ringLen = (ringPct / 100) * ringCirc;
            const ringColor = (row.indicatorLevel === 'CRITICAL' || row.indicatorLevel === 'RED') ? 'var(--danger)'
              : row.indicatorLevel === 'AMBER' ? 'var(--warn)' : 'var(--ok)';
          %>
            <div class="card delay-item"
                 data-days="<%= row.daysUsed !== null ? row.daysUsed : 0 %>"
                 data-closing="<%= row.closingAt ? new Date(row.closingAt).getTime() : Number.MAX_SAFE_INTEGER %>">
              <div class="delay-row">
                <span class="delay-row-icon"><%- include('partials/icon', { name: entityTypeIcon[row.entityType] || 'clipboard', size: 18 }) %></span>
                <div class="delay-row-main">
                  <div class="delay-row-title"><a href="<%= row.detailHref %>"><%= row.bidTitle %></a><% if (row.entityType !== 'LOT') { %> <span class="badge" style="margin-left:0.4rem;"><%= row.entityType %></span><% } %></div>
                  <div class="muted delay-row-sub"><%= row.lotLabel %></div>
                  <div class="mt-1">
                    <a class="badge <%= indicatorBadgeClass(row.indicatorLevel) %>"
                       <% if (row.daysUsed !== null && row.targetDays !== null) { %>title="<%= row.daysUsed.toFixed(1) %>d / <%= row.targetDays.toFixed(1) %>d target"<% } %>
                       href="<%= stageHistoryHref(row.entityType, row.entityId, { title: row.bidTitle, subtitle: row.lotLabel, backHref: row.detailHref, backLabel: 'Back' }) %>"><%= row.indicatorLevel %></a>
                  </div>
                  <div class="muted" style="font-size:0.78rem;"><% if (row.daysUsed !== null && row.targetDays !== null) { %><%= Math.round(row.daysUsed) %>d in stage &middot; target <%= Math.round(row.targetDays) %>d<% } %><% if (row.waitingOnParty) { %> &middot; Waiting on <strong><%= row.waitingOnParty %></strong><% } %></div>
                </div>
                <div class="delay-ring-wrap">
                  <svg viewBox="0 0 64 64" class="donut-chart mini" role="img" aria-label="<%= row.percentUsed !== null ? Math.round(row.percentUsed) + '% of target' : 'No target set' %>">
                    <circle cx="32" cy="32" r="<%= ringR %>" fill="none" stroke="var(--border)" stroke-width="7"/>
                    <% if (row.percentUsed !== null) { %>
                    <circle cx="32" cy="32" r="<%= ringR %>" fill="none" stroke="<%= ringColor %>" stroke-width="7"
                            stroke-dasharray="<%= ringLen %> <%= ringCirc - ringLen %>" stroke-linecap="round" transform="rotate(-90 32 32)"/>
                    <% } %>
                    <text x="32" y="29" text-anchor="middle" class="donut-total"><%= row.percentUsed !== null ? Math.round(row.percentUsed) + '%' : '-' %></text>
                    <text x="32" y="41" text-anchor="middle" class="donut-total-label">of target</text>
                  </svg>
                </div>
                <div class="delay-row-meta">
                  <div class="delay-row-meta-col">
                    <span class="delay-row-meta-label">Division</span>
                    <span class="delay-row-meta-value"><%- include('partials/icon', { name: 'building', size: 13 }) %> <%= row.divisionName || '—' %></span>
                  </div>
                  <div class="delay-row-meta-col">
                    <span class="delay-row-meta-label">Owner</span>
                    <span class="delay-row-meta-value"><%- include('partials/icon', { name: 'user', size: 13 }) %> <%= row.officerNames && row.officerNames.length ? row.officerNames[0] : 'Unassigned' %></span>
                  </div>
                  <div class="delay-row-meta-col">
                    <span class="delay-row-meta-label">Closing Date</span>
                    <span class="delay-row-meta-value"><%- include('partials/icon', { name: 'calendar', size: 13 }) %> <%= row.closingAt ? formatDate(row.closingAt) : '—' %></span>
                  </div>
                </div>
                <div class="delay-row-actions">
                  <a class="btn btn-xs" href="<%= row.detailHref %>">View bid</a>
                  <span class="delay-row-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 16 }) %></span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <script>
          (function () {
            var sortSelect = document.getElementById('delay-sort');
            var list = document.getElementById('delay-list');
            if (!sortSelect || !list) return;
            sortSelect.addEventListener('change', function () {
              var key = sortSelect.value === 'closing' ? 'closing' : 'days';
              var items = Array.prototype.slice.call(list.children);
              items.sort(function (a, b) {
                return key === 'closing'
                  ? Number(a.getAttribute('data-closing')) - Number(b.getAttribute('data-closing'))
                  : Number(b.getAttribute('data-days')) - Number(a.getAttribute('data-days'));
              });
              items.forEach(function (item) { list.appendChild(item); });
            });
          })();
        </script>
      <% } %>
    </div>

    <div class="col" style="flex:1; min-width:19rem;">
      <h2 class="mt-1"><%- include('partials/icon', { name: 'bulb' }) %> Delay insights</h2>
      <div class="priority-list">
        <a class="priority-item" href="/delays">
          <span class="priority-item-icon"><%- include('partials/icon', { name: 'clock', size: 18 }) %></span>
          <span class="priority-item-body">
            <span class="priority-item-title">Longest delays</span>
            <span class="priority-item-detail">Top bids by days over target</span>
          </span>
          <span class="priority-item-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 16 }) %></span>
        </a>
        <a class="priority-item" href="/reports/delay-analytics#breakdowns">
          <span class="priority-item-icon"><%- include('partials/icon', { name: 'grid', size: 18 }) %></span>
          <span class="priority-item-body">
            <span class="priority-item-title">Delays by division</span>
            <span class="priority-item-detail">Which divisions are most affected</span>
          </span>
          <span class="priority-item-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 16 }) %></span>
        </a>
        <a class="priority-item" href="/reports/delay-analytics#delay-reason-pareto">
          <span class="priority-item-icon"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span>
          <span class="priority-item-body">
            <span class="priority-item-title">Common blockers</span>
            <span class="priority-item-detail">Top reasons for delays</span>
          </span>
          <span class="priority-item-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 16 }) %></span>
        </a>
        <a class="priority-item" href="/reports/delay-analytics#monthly-trend">
          <span class="priority-item-icon"><%- include('partials/icon', { name: 'trending', size: 18 }) %></span>
          <span class="priority-item-body">
            <span class="priority-item-title">Trends &amp; patterns</span>
            <span class="priority-item-detail">Recent changes and insights</span>
          </span>
          <span class="priority-item-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 16 }) %></span>
        </a>
      </div>

      <h2 class="mt-3">Delay breakdown</h2>
      <div class="card">
        <%
          const breakdownColors = { Critical: 'var(--danger)', Red: 'color-mix(in srgb, var(--danger) 55%, transparent)', Amber: 'var(--warn)', 'On track': 'var(--ok)' };
          const breakdownCounts = { Critical: data.delaySummary.criticalCount, Red: data.delaySummary.redCount, Amber: data.delaySummary.amberCount, 'On track': data.delaySummary.greenCount };
          const breakdownTotal = Math.max(1, Object.values(breakdownCounts).reduce((a, b) => a + b, 0));
          const breakdownR = 60, breakdownCirc = 2 * Math.PI * breakdownR;
          let breakdownOffset = 0;
        %>
        <svg viewBox="0 0 160 160" class="donut-chart" role="img" aria-label="Delay breakdown">
          <circle cx="80" cy="80" r="<%= breakdownR %>" fill="none" stroke="var(--border)" stroke-width="18"/>
          <% Object.keys(breakdownCounts).forEach(label => {
            const count = breakdownCounts[label];
            const segLen = (count / breakdownTotal) * breakdownCirc;
            if (count > 0) { %>
            <circle cx="80" cy="80" r="<%= breakdownR %>" fill="none" stroke="<%= breakdownColors[label] %>" stroke-width="18"
                    stroke-dasharray="<%= segLen %> <%= breakdownCirc - segLen %>" stroke-dashoffset="<%= -breakdownOffset %>" transform="rotate(-90 80 80)"/>
            <% }
            breakdownOffset += segLen;
          %>
          <% }) %>
          <text x="80" y="76" text-anchor="middle" class="donut-total"><%= dominantDelay.count %></text>
          <text x="80" y="94" text-anchor="middle" class="donut-total-label"><%= dominantDelay.label %></text>
        </svg>
        <div class="donut-legend">
          <% Object.keys(breakdownCounts).forEach(label => { %>
            <div class="donut-legend-row">
              <span class="donut-dot" style="background:<%= breakdownColors[label] %>;"></span>
              <span><%= label %></span>
              <strong><%= breakdownCounts[label] %></strong>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="next-steps-card mt-3">
        <h3 class="mt-0"><%- include('partials/icon', { name: 'target', size: 18 }) %> Recommended next steps</h3>
        <ol class="next-steps-list">
          <li><span class="next-step-num">1</span> Review and update stage timelines</li>
          <li><span class="next-step-num">2</span> Assign owners to unassigned bids</li>
          <li><span class="next-step-num">3</span> Resolve key blockers (MAF, quotes, bonds)</li>
          <li><span class="next-step-num">4</span> Track progress in the Delays board</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<section id="pipeline-performance" class="tab-panel" role="tabpanel" aria-labelledby="tab-pipeline-performance" tabindex="-1">
  <div class="section-header-row">
    <div class="section-header-icon"><%- include('partials/icon', { name: 'trending', size: 22 }) %></div>
    <div class="section-header-text">
      <h2 class="mt-0">Pipeline &amp; Performance</h2>
      <p class="muted mt-0">Track pipeline value, monitor bid outcomes, and understand performance by division, officer, and OEM.</p>
    </div>
  </div>

  <%
    const totalLotsTracked = data.pipelineByDivision.reduce((s, r) => s + r.lotCount, 0);
    const decidedWon = data.winRateByDivision.reduce((s, r) => s + r.wonCount, 0);
    const decidedLost = data.winRateByDivision.reduce((s, r) => s + r.lostCount, 0);
    const overallWinRate = (decidedWon + decidedLost) > 0 ? Math.round((decidedWon / (decidedWon + decidedLost)) * 100) : null;
  %>
  <div class="stat-grid chevron-stat-grid" hx-boost="false">
    <a class="stat-card stat-blue" href="#pipeline">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'coins' }) %></span>
        <span class="stat-label">Priced Pipeline</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= formatMoney(pipelineEtbTotal, 'ETB') %></span>
      <span class="muted" style="font-size:0.78rem;"><%= formatMoney(pipelineUsdTotal, 'USD') %></span>
    </a>
    <a class="stat-card stat-green" href="#pipeline">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'clipboard' }) %></span>
        <span class="stat-label">Lots Tracked</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= totalLotsTracked %></span>
      <span class="muted" style="font-size:0.78rem;">Active lots in pipeline</span>
    </a>
    <a class="stat-card stat-purple" href="#performance-breakdown">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'trophy' }) %></span>
        <span class="stat-label">Win Rate</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= overallWinRate !== null ? overallWinRate + '%' : '—' %></span>
      <span class="muted" style="font-size:0.78rem;"><%= overallWinRate !== null ? decidedWon + 'W / ' + decidedLost + 'L' : 'No outcomes yet' %></span>
    </a>
    <a class="stat-card stat-orange" href="/bids?status=UNDER_EVALUATION">
      <span class="stat-card-top">
        <span class="stat-icon"><%- include('partials/icon', { name: 'clock' }) %></span>
        <span class="stat-label">Pending Outcomes</span>
        <span class="stat-card-chevron"><%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></span>
      </span>
      <span class="stat-value"><%= data.bidsPastOpeningNoResult.length %></span>
      <span class="muted" style="font-size:0.78rem;">Bids awaiting result</span>
    </a>
  </div>

  <div class="card mt-2" id="pipeline">
    <div class="row" style="justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
      <h3 class="mt-0">Pipeline by Division</h3>
      <div class="row tight">
        <select id="pipeline-division-filter" class="w-auto" onchange="if (this.value) location.href = this.value;">
          <% data.divisionFilters.forEach(pill => { %>
            <option value="/dashboard<%= pill.filterParam ? '?division=' + encodeURIComponent(pill.filterParam) : '' %>#pipeline-performance" <%= (pill.filterParam || null) === currentDivision ? 'selected' : '' %>><%= pill.label %></option>
          <% }) %>
        </select>
        <select id="pipeline-currency-filter" class="w-auto">
          <option value="">Currency: All</option>
          <option value="etb">ETB only</option>
          <option value="usd">USD only</option>
        </select>
      </div>
    </div>

    <% if (data.pipelineByDivision.length === 0) { %>
      <div class="empty-state">
        <span class="empty-state-icon"><%- include('partials/icon', { name: 'bar-chart', size: 26 }) %></span>
        <p class="empty-state-title">No priced lots yet</p>
        <p class="empty-state-text">Pipeline values appear when bid lot prices are recorded.</p>
      </div>
    <% } else { %>
      <div class="table-scroll mt-1">
      <table id="pipeline-division-table">
        <thead><tr><th>Division</th><th>ETB Value</th><th>USD Value</th><th>Lots</th></tr></thead>
        <tbody>
          <% data.pipelineByDivision.forEach(row => { %>
            <tr data-etb="<%= row.totalEtb %>" data-usd="<%= row.totalUsd %>">
              <td><%= row.groupLabel %></td><td><%= formatMoney(row.totalEtb) %></td><td><%= formatMoney(row.totalUsd) %></td><td><%= row.lotCount %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <p class="muted mt-1" style="font-size:0.78rem;">ETB and USD are tracked separately, never summed.</p>
    <% } %>
  </div>

  <% if (data.pipelineByStatus.length > 0) { %>
    <div class="card mt-2">
      <h3 class="mt-0">Pipeline value by status</h3>
      <div class="table-scroll">
      <table>
        <thead><tr><th>Status</th><th>ETB</th><th>USD</th><th>Lots</th></tr></thead>
        <tbody>
          <% data.pipelineByStatus.forEach(row => { %>
            <tr><td><%= row.groupLabel %></td><td><%= formatMoney(row.totalEtb) %></td><td><%= formatMoney(row.totalUsd) %></td><td><%= row.lotCount %></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>
  <% } %>

  <% if (data.bidsPastOpeningNoResult.length > 0) { %>
    <div class="card outcome-banner mt-2">
      <span class="outcome-banner-icon"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span>
      <div class="outcome-banner-body">
        <strong><%= data.bidsPastOpeningNoResult.length %> bid<%= data.bidsPastOpeningNoResult.length === 1 ? ' is' : 's are' %> past opening with no result</strong>
        <div class="muted mt-1"><%- include('partials/icon', { name: 'calendar', size: 13 }) %> <%= data.bidsPastOpeningNoResult.map(r => r.title + ' (' + formatDate(r.openingAt) + ')').join(', ') %></div>
      </div>
      <a class="btn" href="/bids?status=UNDER_EVALUATION">Record Outcome <%- include('partials/icon', { name: 'chevron-right', size: 14 }) %></a>
    </div>
  <% } %>

  <h2 id="performance-breakdown" class="mt-3">Performance Breakdown</h2>
  <div class="row tight perf-tabs" role="tablist" aria-label="Performance breakdown dimension">
    <button type="button" class="pill active" data-perf-tab="division">By Division</button>
    <button type="button" class="pill" data-perf-tab="officer">By Officer</button>
    <button type="button" class="pill" data-perf-tab="oem">By OEM</button>
  </div>

  <%
    const perfPanels = [
      { key: 'division', icon: 'bar-chart', rows: data.winRateByDivision },
      { key: 'officer', icon: 'user', rows: data.winRateByOfficer },
      { key: 'oem', icon: 'building', rows: data.winRateByOem },
    ];
  %>
  <% perfPanels.forEach((panel, panelIndex) => {
    const decidedRows = panel.rows.filter(r => r.wonCount + r.lostCount > 0);
  %>
    <div class="card perf-panel" data-perf-panel="<%= panel.key %>"<%= panelIndex === 0 ? '' : ' hidden' %>>
      <% if (decidedRows.length === 0) { %>
        <div class="empty-state">
          <span class="empty-state-icon"><%- include('partials/icon', { name: panel.icon, size: 26 }) %></span>
          <p class="empty-state-title">No decided bids yet</p>
          <p class="empty-state-text">Won, lost and rate statistics will appear once bid outcomes are recorded.</p>
        </div>
      <% } else { %>
        <div class="bar-chart">
          <% decidedRows.forEach(row => {
            const total = row.wonCount + row.lostCount;
          %>
            <div class="bar-row">
              <span class="bar-label" title="<%= row.groupLabel %>"><%= row.groupLabel %></span>
              <div class="bar-track stacked">
                <div class="bar-fill won" style="width: <%= Math.round((row.wonCount / total) * 100) %>%;"></div>
                <div class="bar-fill lost" style="width: <%= Math.round((row.lostCount / total) * 100) %>%;"></div>
              </div>
              <span class="bar-value"><%= row.winRatePercent %>% (<%= row.wonCount %>W / <%= row.lostCount %>L)</span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% }) %>

  <script>
    (function () {
      var tabs = document.querySelectorAll('.perf-tabs [data-perf-tab]');
      var panels = document.querySelectorAll('[data-perf-panel]');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
          panels.forEach(function (p) { p.hidden = p.getAttribute('data-perf-panel') !== tab.getAttribute('data-perf-tab'); });
        });
      });

      var currencyFilter = document.getElementById('pipeline-currency-filter');
      var divisionTable = document.getElementById('pipeline-division-table');
      if (currencyFilter && divisionTable) {
        currencyFilter.addEventListener('change', function () {
          var field = currencyFilter.value === 'etb' ? 'etb' : (currencyFilter.value === 'usd' ? 'usd' : null);
          divisionTable.querySelectorAll('tbody tr').forEach(function (row) {
            row.hidden = field !== null && Number(row.getAttribute('data-' + field)) === 0;
          });
        });
      }
    })();
  </script>
</section>

<section id="bonds-deal-regs" class="tab-panel" role="tabpanel" aria-labelledby="tab-bonds-deal-regs" tabindex="-1">
  <div class="section-header-row">
    <div class="section-header-icon"><%- include('partials/icon', { name: 'shield', size: 22 }) %></div>
    <div class="section-header-text">
      <h2 class="mt-0">Bonds &amp; Deal Registrations</h2>
      <p class="muted mt-0">Track bid bonds, monitor expiries and manage deal registrations in one place.</p>
    </div>
  </div>

  <%
    const activeBondsCount = data.outstandingBonds.length;
    const bondsExpiringSoonCount = data.outstandingBonds.filter(b => b.expiringSoon).length;
    const bondDivisionOptions = [...new Set(data.outstandingBonds.flatMap(b => b.divisionNames))].sort((a, b) => a.localeCompare(b));
    function dealRegStatusInfo(reg) {
      if (reg.expiringSoon) return { label: 'Expiring Soon', cls: 'lost' };
      if (reg.status === 'APPROVED') return { label: 'Approved', cls: 'won' };
      if (reg.status === 'SUBMITTED') return { label: 'Pending OEM', cls: 'review' };
      if (reg.status === 'REJECTED') return { label: 'Rejected', cls: 'lost' };
      if (reg.status === 'EXPIRED') return { label: 'Expired', cls: '' };
      return { label: 'Draft', cls: '' };
    }
  %>

  <div class="row top">
    <div class="col" style="flex:2; min-width:30rem;">
      <div class="stat-grid accent-stat-grid" hx-boost="false" id="bonds-outstanding">
        <div class="stat-card stat-blue">
          <span class="stat-card-top">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clipboard' }) %></span>
            <span class="stat-label">Total Bonds Outstanding</span>
          </span>
          <span class="stat-value"><%= formatMoney(data.outstandingBondTotalEtb, 'ETB') %></span>
          <span class="muted" style="font-size:0.78rem;">Across <%= activeBondsCount %> bonds</span>
        </div>
        <div class="stat-card stat-green">
          <span class="stat-card-top">
            <span class="stat-icon"><%- include('partials/icon', { name: 'shield' }) %></span>
            <span class="stat-label">Active Bonds</span>
          </span>
          <span class="stat-value"><%= activeBondsCount %></span>
          <span class="muted" style="font-size:0.78rem;">Valid and in effect</span>
        </div>
        <div class="stat-card stat-orange">
          <span class="stat-card-top">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock' }) %></span>
            <span class="stat-label">Expiring Soon</span>
          </span>
          <span class="stat-value"><%= bondsExpiringSoonCount %></span>
          <span class="muted" style="font-size:0.78rem;">Within next 30 days</span>
        </div>
      </div>
    </div>

    <div class="col" style="flex:1; min-width:18rem;">
      <div class="card">
        <h3 class="mt-0"><%- include('partials/icon', { name: 'clipboard', size: 18 }) %> Deal Registrations</h3>
        <div class="mini-stat-row">
          <div class="mini-stat mini-stat-red">
            <span class="mini-stat-value"><%= data.dealRegistrationSummary.expiringSoonCount %></span>
            <span class="mini-stat-label">Expiring in 30 days</span>
            <span class="muted" style="font-size:0.72rem;">All time</span>
          </div>
          <div class="mini-stat mini-stat-amber">
            <span class="mini-stat-value"><%= data.dealRegistrationSummary.pendingOemCount %></span>
            <span class="mini-stat-label">Pending OEM</span>
            <span class="muted" style="font-size:0.72rem;">Awaiting approval</span>
          </div>
          <div class="mini-stat mini-stat-green">
            <span class="mini-stat-value"><%= data.dealRegistrationSummary.approvedCount %></span>
            <span class="mini-stat-label">Approved</span>
            <span class="muted" style="font-size:0.72rem;">Active registrations</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row top mt-2">
    <div class="col" style="flex:2; min-width:30rem;">
      <div class="card">
        <h3 class="mt-0">Bid Bonds Outstanding</h3>
        <p class="muted mt-0" style="font-size:0.82rem;"><%= activeBondsCount %> bonds &middot; Soonest expiry first</p>

        <% if (activeBondsCount === 0) { %>
          <div class="empty-state">
            <span class="empty-state-icon"><%- include('partials/icon', { name: 'shield', size: 26 }) %></span>
            <p class="empty-state-title">No outstanding bid bonds</p>
            <p class="empty-state-text">Bonds appear here once a bid lot records a bond amount.</p>
          </div>
        <% } else { %>
          <div class="schedule-toolbar">
            <div class="row tight schedule-toolbar-group" style="flex:1;">
              <input type="search" id="bonds-search" placeholder="Search by customer, bid or reference..." class="col">
            </div>
            <div class="row tight schedule-toolbar-group">
              <select id="bonds-division-filter" class="w-auto">
                <option value="">All Divisions</option>
                <% bondDivisionOptions.forEach(name => { %><option value="<%= name %>"><%= name %></option><% }) %>
              </select>
              <select id="bonds-expiry-filter" class="w-auto">
                <option value="">Expiry: All</option>
                <option value="soon">Expiring soon</option>
              </select>
              <select id="bonds-currency-filter" class="w-auto">
                <option value="">Currency: All</option>
                <option value="ETB">ETB</option>
                <option value="USD">USD</option>
              </select>
              <button type="button" class="secondary btn-xs" id="bonds-clear-filters"><%- include('partials/icon', { name: 'repeat', size: 13 }) %> Clear filters</button>
            </div>
          </div>

          <div class="table-scroll mt-1">
          <table>
            <thead><tr><th>Customer / Bid</th><th>Division</th><th>Lot</th><th>Bond Amount</th><th>Bid Status</th><th>Bond Expiry</th><th>Actions</th></tr></thead>
            <tbody id="bonds-tbody">
              <% data.outstandingBonds.forEach(row => {
                const divisionName = row.divisionNames[0] || '';
                const isClosed = row.bidClosingAt && new Date(row.bidClosingAt).getTime() < Date.now();
                const expiryDays = row.estimatedExpiry ? Math.round((new Date(row.estimatedExpiry) - Date.now()) / 86400000) : null;
              %>
                <tr data-search="<%= (row.organizationName + ' ' + row.bidTitle).toLowerCase() %>" data-division="<%= divisionName %>" data-currency="<%= row.currency %>" data-expiring="<%= row.expiringSoon %>">
                  <td>
                    <a href="/bids/<%= row.bidId %>" style="font-weight:600;"><%= row.organizationName %></a>
                    <div class="muted" style="font-size:0.8rem;"><%= row.bidTitle %></div>
                  </td>
                  <td>
                    <% if (divisionName) { %>
                      <span class="row tight" style="font-size:0.85rem; flex-wrap:nowrap;"><%- include('partials/icon', { name: pillIcon(divisionName) || 'square', size: 14 }) %> <%= divisionName %></span>
                    <% } else { %><span class="muted">&mdash;</span><% } %>
                  </td>
                  <td><%= row.lotLabel %></td>
                  <td><%= formatMoney(row.amount, row.currency) %></td>
                  <td><span class="badge <%= isClosed ? '' : 'active' %>"><%= isClosed ? 'Closed' : 'Open' %></span></td>
                  <td>
                    <span class="badge <%= row.expiringSoon ? 'review' : '' %>"><%= formatDate(row.estimatedExpiry) %></span>
                    <% if (expiryDays !== null) { %><div class="muted" style="font-size:0.75rem;">In <%= expiryDays %> days</div><% } %>
                  </td>
                  <td>
                    <div class="row tight" style="flex-wrap:nowrap;">
                      <a class="btn btn-xs" href="/bids/<%= row.bidId %>">View</a>
                      <span class="delay-row-menu" aria-hidden="true"><%- include('partials/icon', { name: 'more', size: 16 }) %></span>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
          <p class="muted mt-1" id="bonds-empty" hidden>No bonds match the current filters.</p>
          <div class="row mt-1" style="justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
            <span class="muted" id="bonds-showing" style="font-size:0.82rem;"></span>
            <div class="pagination" id="bonds-pagination"></div>
          </div>

          <script>
            (function () {
              var searchInput = document.getElementById('bonds-search');
              var divisionFilter = document.getElementById('bonds-division-filter');
              var expiryFilter = document.getElementById('bonds-expiry-filter');
              var currencyFilter = document.getElementById('bonds-currency-filter');
              var clearBtn = document.getElementById('bonds-clear-filters');
              var tbody = document.getElementById('bonds-tbody');
              var emptyMsg = document.getElementById('bonds-empty');
              var showingLabel = document.getElementById('bonds-showing');
              var paginationEl = document.getElementById('bonds-pagination');
              var PAGE_SIZE = 7;
              var currentPage = 1;
              var allRows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));

              function applyFilters() {
                var search = searchInput.value.trim().toLowerCase();
                var division = divisionFilter.value;
                var expiry = expiryFilter.value;
                var currency = currencyFilter.value;

                var matches = allRows.filter(function (row) {
                  return (!search || row.getAttribute('data-search').indexOf(search) !== -1)
                    && (!division || row.getAttribute('data-division') === division)
                    && (!expiry || row.getAttribute('data-expiring') === 'true')
                    && (!currency || row.getAttribute('data-currency') === currency);
                });

                var totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
                if (currentPage > totalPages) currentPage = totalPages;
                var start = (currentPage - 1) * PAGE_SIZE;
                var pageRows = matches.slice(start, start + PAGE_SIZE);

                allRows.forEach(function (row) { row.hidden = true; });
                pageRows.forEach(function (row) { row.hidden = false; });

                emptyMsg.hidden = matches.length !== 0;
                showingLabel.textContent = matches.length === 0 ? '' :
                  'Showing ' + (start + 1) + '-' + (start + pageRows.length) + ' of ' + matches.length + ' bonds';

                renderPagination(totalPages);
              }

              function renderPagination(totalPages) {
                paginationEl.innerHTML = '';
                if (totalPages <= 1) return;
                var prev = document.createElement('button');
                prev.type = 'button'; prev.textContent = '‹'; prev.disabled = currentPage === 1;
                prev.setAttribute('aria-label', 'Previous page');
                prev.addEventListener('click', function () { currentPage--; applyFilters(); });
                paginationEl.appendChild(prev);
                for (var i = 1; i <= totalPages; i++) {
                  (function (page) {
                    var btn = document.createElement('button');
                    btn.type = 'button'; btn.textContent = String(page);
                    btn.setAttribute('aria-label', 'Page ' + page);
                    if (page === currentPage) btn.classList.add('active');
                    btn.addEventListener('click', function () { currentPage = page; applyFilters(); });
                    paginationEl.appendChild(btn);
                  })(i);
                }
                var next = document.createElement('button');
                next.type = 'button'; next.textContent = '›'; next.disabled = currentPage === totalPages;
                next.setAttribute('aria-label', 'Next page');
                next.addEventListener('click', function () { currentPage++; applyFilters(); });
                paginationEl.appendChild(next);
              }

              [searchInput, divisionFilter, expiryFilter, currencyFilter].forEach(function (el) {
                el.addEventListener('input', function () { currentPage = 1; applyFilters(); });
                el.addEventListener('change', function () { currentPage = 1; applyFilters(); });
              });
              clearBtn.addEventListener('click', function () {
                searchInput.value = ''; divisionFilter.value = ''; expiryFilter.value = ''; currencyFilter.value = '';
                currentPage = 1; applyFilters();
              });

              applyFilters();
            })();
          </script>
        <% } %>
        <p class="muted mt-2" style="font-size:0.78rem;">Expiry is estimated from the bond's issue date, or from the bid opening date when no issue date is recorded.</p>
      </div>
    </div>

    <div class="col" style="flex:1; min-width:18rem;">
      <div class="card" id="deal-regs">
        <div class="row" style="justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
          <h3 class="mt-0">Deal Registrations</h3>
          <a class="btn w-auto" href="/deal-registrations/new">+ Register a Deal</a>
        </div>
        <div class="mini-stat-row">
          <div class="mini-stat">
            <span class="mini-stat-value"><%= dealRegistrationsTotal %></span>
            <span class="mini-stat-label">Total Registrations</span>
            <span class="muted" style="font-size:0.72rem;">All time</span>
          </div>
          <div class="mini-stat mini-stat-amber">
            <span class="mini-stat-value"><%= data.dealRegistrationSummary.pendingOemCount %></span>
            <span class="mini-stat-label">Pending OEM</span>
            <span class="muted" style="font-size:0.72rem;">Awaiting approval</span>
          </div>
          <div class="mini-stat mini-stat-green">
            <span class="mini-stat-value"><%= data.dealRegistrationSummary.approvedCount %></span>
            <span class="mini-stat-label">Approved</span>
            <span class="muted" style="font-size:0.72rem;">Active registrations</span>
          </div>
        </div>
        <% if (data.dealRegistrationSummary.bidsPreparingWithoutRegistration.length > 0) { %>
          <p class="muted mt-1" style="font-size:0.8rem;">Bids preparing without a registration: <%= data.dealRegistrationSummary.bidsPreparingWithoutRegistration.join(', ') %>.</p>
        <% } %>

        <div class="row mt-2" style="justify-content:space-between; align-items:center;">
          <h3 class="mt-0">Recent Deal Registrations</h3>
          <a class="view-all" href="/deal-registrations">View all &rarr;</a>
        </div>
        <% if (recentDealRegistrations.length === 0) { %>
          <p class="muted">No deal registrations yet.</p>
        <% } else { %>
          <div class="deal-reg-list mt-1">
            <% recentDealRegistrations.forEach(reg => {
              const statusInfo = dealRegStatusInfo(reg);
              const days = reg.expiryDate ? Math.round((new Date(reg.expiryDate) - Date.now()) / 86400000) : null;
            %>
              <a class="deal-reg-row" href="/deal-registrations/<%= reg.id %>">
                <div class="deal-reg-row-main">
                  <strong><%= reg.title %></strong>
                  <div class="muted" style="font-size:0.8rem;"><%= reg.organization ? reg.organization.name : '-' %></div>
                </div>
                <div class="deal-reg-row-meta">
                  <span class="muted" style="font-size:0.8rem;"><%= reg.oem ? reg.oem.name : '-' %></span>
                  <span class="badge <%= statusInfo.cls %>"><%= statusInfo.label %></span>
                  <span class="muted" style="font-size:0.78rem;"><%= formatDate(reg.expiryDate) %><% if (days !== null) { %> &middot; In <%= days %>d<% } %></span>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/tabNavScript') %>

<%- include('partials/footer') %>
