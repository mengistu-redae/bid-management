<%- include('partials/header', { title: title, user: user }) %>

<div class="dash-header">
  <div>
    <p class="muted mt-0" style="margin-bottom:0.15rem;"><%= updatedAtLabel %></p>
    <h1 class="mt-0">Executive Overview</h1>
  </div>
  <form method="get" action="/bids" class="dash-search" role="search">
    <%- include('partials/icon', { name: 'search', size: 16 }) %>
    <input type="text" name="search" placeholder="Search bids, customers, reference numbers">
  </form>
  <div class="row tight">
    <a class="btn secondary" href="/bids/export">Export</a>
    <a class="btn" href="/bids/new">+ Log new tender</a>
  </div>
</div>

<div class="division-pills">
  <% data.divisionFilters.forEach(pill => { %>
    <a class="pill<%= (pill.filterParam || null) === currentDivision ? ' active' : '' %>"
       href="/dashboard<%= pill.filterParam ? '?division=' + encodeURIComponent(pill.filterParam) : '' %>">
      <%= pill.label %> <span class="pill-count"><%= pill.closingSoonCount %></span>
    </a>
  <% }) %>
</div>

<%
  const pipelineEtbTotal = data.pipelineByDivision.reduce((sum, r) => sum + Number(r.totalEtb), 0);
  const pipelineUsdTotal = data.pipelineByDivision.reduce((sum, r) => sum + Number(r.totalUsd), 0);
  const missingWithin48h = data.missingReadiness.filter(r => r.closingAt && (new Date(r.closingAt).getTime() - Date.now()) < 48 * 3600 * 1000).length;
  const notStartedCount = data.closingThisWeek.filter(r => r.readinessGaps.includes('Go / no-go')).length;
  const unassignedCount = data.closingThisWeek.filter(r => r.readinessGaps.includes('Owner')).length;
  const behindTarget = data.delaySummary.amberCount + data.delaySummary.redCount + data.delaySummary.criticalCount;
%>
<div class="stat-grid" hx-boost="false">
  <a class="stat-card<%= behindTarget > 0 ? ' warn' : '' %>" href="#closing-soon">
    <span class="stat-icon"><%- include('partials/icon', { name: 'calendar' }) %></span>
    <span class="stat-value"><%= data.closingThisWeek.length %></span>
    <span class="stat-label">Closing in 7 days</span>
    <span class="muted" style="font-size:0.78rem;"><%= notStartedCount %> not started &middot; <%= unassignedCount %> unassigned</span>
  </a>
  <a class="stat-card<%= data.missingReadiness.length > 0 ? ' warn' : '' %>" href="#closing-soon">
    <span class="stat-icon"><%- include('partials/icon', { name: 'alert' }) %></span>
    <span class="stat-value"><%= data.missingReadiness.length %></span>
    <span class="stat-label">Missing MAF or quote</span>
    <span class="muted" style="font-size:0.78rem;"><%= missingWithin48h %> close within 48h</span>
  </a>
  <a class="stat-card<%= (data.delaySummary.criticalCount + data.delaySummary.redCount) > 0 ? ' danger' : (data.delaySummary.amberCount > 0 ? ' warn' : '') %>" href="#stuck">
    <span class="stat-icon"><%- include('partials/icon', { name: 'alert' }) %></span>
    <span class="stat-value"><%= behindTarget %></span>
    <span class="stat-label">Behind stage target</span>
    <span class="muted" style="font-size:0.78rem;"><%= data.delaySummary.criticalCount %> critical &middot; <%= data.delaySummary.redCount %> red &middot; <%= data.delaySummary.amberCount %> amber</span>
  </a>
  <a class="stat-card" href="#pipeline">
    <span class="stat-icon"><%- include('partials/icon', { name: 'trending' }) %></span>
    <span class="stat-value"><%= formatMoney(pipelineEtbTotal) %></span>
    <span class="stat-label">Open pipeline</span>
    <span class="muted" style="font-size:0.78rem;">USD <%= new Intl.NumberFormat('en-US').format(pipelineUsdTotal) %> &middot; <%= data.unpricedBidCount %> bids unpriced</span>
  </a>
  <a class="stat-card<%= data.bondsExpiringWithin90DaysCount > 0 ? ' warn' : '' %>" href="#bonds-outstanding">
    <span class="stat-icon"><%- include('partials/icon', { name: 'shield' }) %></span>
    <span class="stat-value"><%= formatMoney(data.outstandingBondTotalEtb) %></span>
    <span class="stat-label">Bid bonds outstanding</span>
    <span class="muted" style="font-size:0.78rem;"><%= data.bondsExpiringWithin90DaysCount %> expires within 90 days</span>
  </a>
  <a class="stat-card<%= data.expiringDealRegistrations.length > 0 ? ' warn' : '' %>" href="#deal-regs">
    <span class="stat-icon"><%- include('partials/icon', { name: 'repeat' }) %></span>
    <span class="stat-value"><%= data.expiringDealRegistrations.length %></span>
    <span class="stat-label">Deal regs expiring</span>
    <span class="muted" style="font-size:0.78rem;">next 30 days</span>
  </a>
</div>

<div class="row top">
  <div class="col" style="flex:3; min-width:22rem;">
    <h2 class="mt-1"><%- include('partials/icon', { name: 'alert' }) %> Priority actions</h2>
    <% if (priorityActions.length === 0) { %>
      <p class="muted">Nothing needs attention right now.</p>
    <% } else { %>
      <div class="priority-list">
        <% priorityActions.forEach(action => { %>
          <a class="priority-item <%= action.urgency %>" href="<%= action.href %>">
            <span class="priority-item-icon"><%- include('partials/icon', { name: action.icon, size: 18 }) %></span>
            <span class="priority-item-body">
              <span class="priority-item-title"><%= action.title %></span>
              <span class="priority-item-detail"><%= action.detail %></span>
            </span>
            <span class="priority-item-badge badge <%= action.urgency === 'urgent' ? 'lost' : (action.urgency === 'high' ? 'review' : 'active') %>"><%= action.urgency %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="col" style="flex:2; min-width:18rem;">
    <h2 class="mt-1"><%- include('partials/icon', { name: 'trending' }) %> Bid pipeline</h2>
    <% const maxStageCount = Math.max(1, ...data.lifecycleStages.map(s => s.bidCount)); %>
    <% if (data.lifecycleStages.every(s => s.bidCount === 0)) { %>
      <p class="muted">No open bids in the tracked lifecycle stages yet.</p>
    <% } else { %>
      <div class="bar-chart">
        <% data.lifecycleStages.forEach(stage => { %>
          <div class="bar-row">
            <span class="bar-label"><%= stage.stageLabel %></span>
            <div class="bar-track"><div class="bar-fill" style="width: <%= Math.round((stage.bidCount / maxStageCount) * 100) %>%;"></div></div>
            <span class="bar-value"><%= stage.bidCount %><% if (Number(stage.totalEtb) > 0) { %> &middot; <%= formatMoney(stage.totalEtb) %><% } %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<% if (data.missingReadiness.length > 0) { %>
<h2 id="readiness-gaps" class="mt-3"><%- include('partials/icon', { name: 'alert' }) %> Bid readiness gaps</h2>
<p class="muted mt-0">Open bids still missing a MAF or vendor quote, regardless of closing date</p>
<div class="table-scroll">
<table>
  <thead><tr><th>Bid</th><th>Division</th><th>Gaps</th><th>Owner</th><th>Closing</th></tr></thead>
  <tbody>
    <% data.missingReadiness.forEach(row => { %>
      <tr onclick="window.location='/bids/<%= row.bidId %>'" style="cursor:pointer;">
        <td>
          <a href="/bids/<%= row.bidId %>"><%= row.title %></a>
          <div class="muted" style="font-size:0.8rem;"><%= row.organizationName %></div>
        </td>
        <td><%= row.divisionNames.length ? row.divisionNames.join(', ') : '-' %></td>
        <td><% row.readinessGaps.forEach(gap => { %><span class="badge gap-badge"><%= gap %></span><% }) %></td>
        <td><%= row.ownerLabel || 'Unassigned' %></td>
        <td class="muted"><%= row.closingAt ? formatDate(row.closingAt) : 'No closing date' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>

<div class="row top mt-3">
  <div class="col" style="flex:2; min-width:28rem;">
    <h2 id="closing-soon" class="mt-1"><%- include('partials/icon', { name: 'calendar' }) %> Closing in the next 7 days</h2>
    <p class="muted mt-0">Sorted by closing time &middot; one row per bid, lots grouped</p>
    <% if (data.closingThisWeek.length === 0) { %>
      <p class="muted">Nothing closing in the next 7 days.</p>
    <% } else { %>
      <div class="table-scroll">
      <table>
        <thead><tr><th>Time</th><th>Bid</th><th>Division</th><th>Readiness gaps</th><th>Owner</th><th>Bid bond</th></tr></thead>
        <tbody>
          <% closingThisWeekByDate.forEach(group => { %>
            <tr class="date-divider">
              <td colspan="6">
                <%= group.label %><% if (group.relative) { %> <span class="badge"><%= group.relative %></span><% } %>
                <span class="muted"><%= group.rows.length %> bid<%= group.rows.length === 1 ? '' : 's' %></span>
              </td>
            </tr>
            <% group.rows.forEach(row => { %>
              <tr onclick="window.location='/bids/<%= row.bidId %>'" style="cursor:pointer;">
                <td class="muted"><%= new Date(row.closingAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Africa/Addis_Ababa' }) %></td>
                <td>
                  <a href="/bids/<%= row.bidId %>"><%= row.title %></a>
                  <div class="muted" style="font-size:0.8rem;"><%= row.organizationName %></div>
                </td>
                <td><%= row.divisionNames.length ? row.divisionNames.join(', ') : '-' %></td>
                <td>
                  <% row.readinessGaps.forEach(gap => { %><span class="badge gap-badge"><%= gap %></span><% }) %>
                  <% if (row.readinessGaps.length === 0) { %><span class="badge won">Ready</span><% } %>
                </td>
                <td><%= row.ownerLabel || 'Unassigned' %></td>
                <td>
                  <% if (Number(row.bidBondAmountEtb) > 0) { %><%= formatMoney(row.bidBondAmountEtb, 'ETB') %><% } %>
                  <% if (Number(row.bidBondAmountUsd) > 0) { %><%= formatMoney(row.bidBondAmountUsd, 'USD') %><% } %>
                  <% if (Number(row.bidBondAmountEtb) === 0 && Number(row.bidBondAmountUsd) === 0) { %><span class="muted">-</span><% } %>
                </td>
              </tr>
            <% }) %>
          <% }) %>
        </tbody>
      </table>
      </div>
      <a class="view-all" href="/bids?<%= new URLSearchParams(dateRanges.closingThisWeek).toString() %>">Open in bid list &rarr;</a>
    <% } %>

    <h3 class="mt-3">Next week</h3>
    <% if (data.closingNextWeek.length === 0) { %>
      <p class="muted">Nothing closing 7-14 days out.</p>
    <% } else { %>
      <div class="next-week-strip">
        <% data.closingNextWeek.forEach(row => { %>
          <a class="next-week-item" href="/bids/<%= row.bidId %>">
            <strong><%= formatDate(row.closingAt) %></strong> &middot; <%= row.organizationName %> <%= row.title %>
            <span class="badge <%= statusBadgeClass(row.status) %>"><%= row.status %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="col" style="flex:1; min-width:20rem;">
    <h2 id="stuck" class="mt-1"><%- include('partials/icon', { name: 'alert' }) %> Where deals are stuck</h2>
    <a class="view-all" href="/delays">Delays board &rarr;</a>
    <%
      const segTotal = data.delaySummary.criticalCount + data.delaySummary.redCount + data.delaySummary.amberCount + data.delaySummary.greenCount;
      const segPct = (n) => segTotal > 0 ? (n / segTotal * 100) : 0;
    %>
    <div class="segmented-bar mt-1">
      <% if (data.delaySummary.criticalCount > 0) { %><div class="segment critical" style="width:<%= segPct(data.delaySummary.criticalCount) %>%;"></div><% } %>
      <% if (data.delaySummary.redCount > 0) { %><div class="segment red" style="width:<%= segPct(data.delaySummary.redCount) %>%;"></div><% } %>
      <% if (data.delaySummary.amberCount > 0) { %><div class="segment amber" style="width:<%= segPct(data.delaySummary.amberCount) %>%;"></div><% } %>
      <% if (data.delaySummary.greenCount > 0) { %><div class="segment green" style="width:<%= segPct(data.delaySummary.greenCount) %>%;"></div><% } %>
    </div>
    <div class="row tight mt-1" style="font-size:0.82rem;">
      <span><span class="status-dot" style="background:var(--danger);"></span> Critical <%= data.delaySummary.criticalCount %></span>
      <span><span class="status-dot" style="background:var(--danger);opacity:0.6;"></span> Red <%= data.delaySummary.redCount %></span>
      <span><span class="status-dot" style="background:var(--warn);"></span> Amber <%= data.delaySummary.amberCount %></span>
      <span><span class="status-dot" style="background:var(--ok);"></span> On track <%= data.delaySummary.greenCount %></span>
    </div>
    <p class="muted" style="font-size:0.82rem;">Stale <%= data.delaySummary.staleCount %></p>

    <% if (data.delaySummary.topDelayed.length === 0) { %>
      <p class="muted">Nothing behind target right now.</p>
    <% } else { %>
      <div class="stack mt-2">
        <% data.delaySummary.topDelayed.slice(0, 5).forEach(row => { %>
          <div class="card delay-item" onclick="window.location='<%= row.detailHref %>'">
            <div class="row" style="justify-content:space-between; align-items:flex-start;">
              <div>
                <div class="bid-card-title"><%= row.bidTitle %><% if (row.entityType !== 'LOT') { %> <span class="badge" style="margin-left:0.4rem;"><%= row.entityType %></span><% } %></div>
                <div class="muted" style="font-size:0.8rem;"><%= row.lotLabel %><% if (row.divisionName) { %> &middot; <%= row.divisionName %><% } %></div>
              </div>
              <a class="badge <%= indicatorBadgeClass(row.indicatorLevel) %>" onclick="event.stopPropagation()"
                 <% if (row.daysUsed !== null && row.targetDays !== null) { %>title="<%= row.daysUsed.toFixed(1) %>d / <%= row.targetDays.toFixed(1) %>d target"<% } %>
                 href="<%= stageHistoryHref(row.entityType, row.entityId, { title: row.bidTitle, subtitle: row.lotLabel, backHref: row.detailHref, backLabel: 'Back' }) %>"><%= row.indicatorLevel %><% if (row.percentUsed !== null) { %> &middot; <%= Math.round(row.percentUsed) %>%<% } %></a>
            </div>
            <div class="progress-bar mt-1"><div style="width:<%= Math.min(100, row.percentUsed || 0) %>%; background:<%= row.indicatorLevel === 'CRITICAL' || row.indicatorLevel === 'RED' ? 'var(--danger)' : 'var(--warn)' %>;"></div></div>
            <div class="row tight mt-1" style="font-size:0.78rem;">
              <span class="muted"><% if (row.daysUsed !== null && row.targetDays !== null) { %><%= Math.round(row.daysUsed) %>d in stage &middot; target <%= Math.round(row.targetDays) %>d<% } %></span>
              <% if (row.waitingOnParty) { %><span class="muted">Waiting on <strong><%= row.waitingOnParty %></strong></span><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<h2 id="pipeline" class="mt-3"><%- include('partials/icon', { name: 'trending' }) %> Pipeline by division</h2>
<p class="muted mt-0">ETB and USD are tracked separately, never summed</p>
<div class="table-scroll">
<table>
  <thead><tr><th>Division</th><th>ETB</th><th>USD</th><th>Lots</th></tr></thead>
  <tbody>
    <% data.pipelineByDivision.forEach(row => { %>
      <tr><td><%= row.groupLabel %></td><td><%= formatMoney(row.totalEtb) %></td><td><%= formatMoney(row.totalUsd) %></td><td><%= row.lotCount %></td></tr>
    <% }) %>
    <% if (data.pipelineByDivision.length === 0) { %><tr><td colspan="4" class="muted">No priced lots yet.</td></tr><% } %>
  </tbody>
</table>
</div>

<h2 class="mt-3">Win rate</h2>
<div class="card">
  <% const anyDecided = data.winRateByDivision.some(r => r.wonCount + r.lostCount > 0); %>
  <% if (!anyDecided) { %>
    <p class="muted mt-0">No outcomes recorded yet. Win rate by division, officer and OEM appears once bids are marked won or lost.</p>
  <% } else { %>
    <div class="bar-chart">
      <% data.winRateByDivision.filter(r => r.wonCount + r.lostCount > 0).forEach(row => { %>
        <% const total = row.wonCount + row.lostCount; %>
        <div class="bar-row">
          <span class="bar-label" title="<%= row.groupLabel %>"><%= row.groupLabel %></span>
          <div class="bar-track stacked">
            <div class="bar-fill won" style="width: <%= Math.round((row.wonCount / total) * 100) %>%;"></div>
            <div class="bar-fill lost" style="width: <%= Math.round((row.lostCount / total) * 100) %>%;"></div>
          </div>
          <span class="bar-value"><%= row.winRatePercent %>% (<%= row.wonCount %>W / <%= row.lostCount %>L)</span>
        </div>
      <% }) %>
    </div>
  <% } %>
  <% if (data.bidsPastOpeningNoResult.length > 0) { %>
    <div class="warning-box mt-2">
      <strong><%= data.bidsPastOpeningNoResult.length %> bid<%= data.bidsPastOpeningNoResult.length === 1 ? ' is' : 's are' %> past opening with no result</strong>
      <div class="mt-1"><%= data.bidsPastOpeningNoResult.map(r => r.title + ' (' + formatDate(r.openingAt) + ')').join(', ') %></div>
      <a class="view-all" href="/bids?status=UNDER_EVALUATION">Record outcomes &rarr;</a>
    </div>
  <% } %>
</div>

<div class="row top mt-3">
  <div class="col" style="flex:2; min-width:28rem;">
    <h2 id="bonds-outstanding"><%- include('partials/icon', { name: 'shield' }) %> Bid bonds outstanding</h2>
    <p class="muted mt-0">ETB <%= new Intl.NumberFormat('en-US').format(data.outstandingBondTotalEtb) %> &middot; USD <%= new Intl.NumberFormat('en-US').format(data.outstandingBondTotalUsd) %> &middot; <%= data.outstandingBonds.length %> bonds &middot; soonest expiry first</p>
    <div class="table-scroll">
    <table>
      <thead><tr><th>Customer &middot; bid</th><th>Lot</th><th>Amount</th><th>Bid closes/closed</th><th>Bond expires</th></tr></thead>
      <tbody id="bonds-tbody">
        <% bondsDisplayItems.forEach(item => { %>
          <% if (item.kind === 'divider') { %>
            <tr<%= item.hidden ? ' hidden' : '' %>><td colspan="5" class="subgroup-heading" style="margin:0;"><%= item.label %></td></tr>
          <% } else { %>
            <% const row = item.row; %>
            <tr<%= item.hidden ? ' hidden' : '' %> onclick="window.location='/bids/<%= row.bidId %>'" style="cursor:pointer;">
              <td><strong><%= row.organizationName %></strong><div class="muted" style="font-size:0.8rem;"><%= row.bidTitle %></div></td>
              <td><%= row.lotLabel %></td>
              <td><%= formatMoney(row.amount, row.currency) %></td>
              <td><%= row.bidClosingAt && new Date(row.bidClosingAt).getTime() < Date.now() ? 'Closed ' : 'Closes ' %><%= formatDate(row.bidClosingAt) %></td>
              <td><% if (row.expiringSoon) { %><span class="badge review"><%= formatDate(row.estimatedExpiry) %></span><% } else { %><%= formatDate(row.estimatedExpiry) %><% } %></td>
            </tr>
          <% } %>
        <% }) %>
        <% if (data.outstandingBonds.length === 0) { %><tr><td colspan="5" class="muted">No outstanding bid bonds.</td></tr><% } %>
      </tbody>
    </table>
    </div>
    <% if (data.outstandingBonds.length > bondRowLimit) { %>
      <button type="button" class="secondary w-auto mt-1" id="bonds-show-all">Show all <%= data.outstandingBonds.length %></button>
      <script>
        document.getElementById('bonds-show-all').addEventListener('click', function () {
          document.querySelectorAll('#bonds-tbody [hidden]').forEach(function (el) { el.hidden = false; });
          this.remove();
        });
      </script>
    <% } %>
    <p class="muted">Expiry is estimated from the bond's issue date, or from the bid opening date when no issue date is recorded.</p>
  </div>

  <div class="col" style="flex:1; min-width:18rem;">
    <h2 id="deal-regs"><%- include('partials/icon', { name: 'repeat' }) %> Deal registrations</h2>
    <div class="stat-grid" style="grid-template-columns:repeat(3, 1fr);" hx-boost="false">
      <div class="stat-card">
        <span class="stat-value"><%= data.dealRegistrationSummary.expiringSoonCount %></span>
        <span class="stat-label">Expiring 30d</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= data.dealRegistrationSummary.pendingOemCount %></span>
        <span class="stat-label">Pending OEM</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= data.dealRegistrationSummary.approvedCount %></span>
        <span class="stat-label">Approved</span>
      </div>
    </div>
    <% if (data.dealRegistrationSummary.bidsPreparingWithoutRegistration.length > 0) { %>
      <p class="mt-1">Bids preparing without a registration: <%= data.dealRegistrationSummary.bidsPreparingWithoutRegistration.join(', ') %>.</p>
    <% } %>
    <a class="view-all" href="/deal-registrations/new">Register a deal &rarr;</a>
  </div>
</div>

<h2 class="mt-3">Upcoming clarification deadlines</h2>
<div class="card">
  <% if (data.upcomingClarifications.length === 0) { %><p class="muted">None upcoming.</p><% } %>
  <% clarificationGroups.forEach(group => { %>
    <div class="subgroup-heading"><%= group.label %></div>
    <% group.rows.forEach(row => { %>
      <div class="checklist-item">
        <a href="/bids/<%= row.bidId %>"><%= row.title %></a> - <%= row.organizationName %>
        <% if (row.divisionNames.length) { %><span class="badge"><%= row.divisionNames.join(', ') %></span><% } %>
        <span class="muted"><%= formatDateTime(row.clarificationDeadline) %></span>
      </div>
    <% }) %>
  <% }) %>
</div>

<h2 class="mt-3">By division / status (detail)</h2>
<div class="card">
  <div style="display:flex; gap:2rem; flex-wrap:wrap;">
    <div style="flex:1; min-width:16rem;">
      <strong>By status</strong>
      <table>
        <thead><tr><th>Status</th><th>ETB</th><th>USD</th><th>Lots</th></tr></thead>
        <tbody>
          <% data.pipelineByStatus.forEach(row => { %>
            <tr><td><%= row.groupLabel %></td><td><%= formatMoney(row.totalEtb) %></td><td><%= formatMoney(row.totalUsd) %></td><td><%= row.lotCount %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div style="flex:1; min-width:16rem;">
      <strong>By officer</strong>
      <table>
        <thead><tr><th></th><th>Won</th><th>Lost</th><th>Rate</th></tr></thead>
        <tbody>
          <% data.winRateByOfficer.forEach(row => { %>
            <tr><td><%= row.groupLabel %></td><td><%= row.wonCount %></td><td><%= row.lostCount %></td><td><%= row.winRatePercent %>%</td></tr>
          <% }) %>
          <% if (data.winRateByOfficer.length === 0) { %><tr><td colspan="4" class="muted">No decided bids yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
    <div style="flex:1; min-width:16rem;">
      <strong>By OEM</strong>
      <table>
        <thead><tr><th></th><th>Won</th><th>Lost</th><th>Rate</th></tr></thead>
        <tbody>
          <% data.winRateByOem.forEach(row => { %>
            <tr><td><%= row.groupLabel %></td><td><%= row.wonCount %></td><td><%= row.lostCount %></td><td><%= row.winRatePercent %>%</td></tr>
          <% }) %>
          <% if (data.winRateByOem.length === 0) { %><tr><td colspan="4" class="muted">No decided bids yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

