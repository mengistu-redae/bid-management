<%- include('../partials/header', { title: title, user: user }) %>
<h1>Import</h1>
<p class="muted">Upload one of the two sample spreadsheets. Nothing is saved until you review the preview below, fix up any rows that need it, and confirm.</p>

<div class="card">
  <form method="post" action="/import/preview" enctype="multipart/form-data" hx-boost="false" style="display:flex; gap:1rem; align-items:flex-end;">
    <div>
      <label>Which file is this?</label>
      <select name="kind">
        <option value="upcoming">Upcoming Bid tracker (tender scouting list)</option>
        <option value="tracker">Bids tracker (Bids on hand / Submitted / drop / cancelled)</option>
      </select>
    </div>
    <div class="col">
      <label>File</label>
      <input type="file" name="file" accept=".xlsx" required>
    </div>
    <div><button type="submit">Preview</button></div>
  </form>
</div>

<% if (preview) { %>
  <p class="muted mt-2">Edit any row below before confirming - organization, title and division are the fields most often worth fixing by hand. Check "Skip" to leave a row out entirely.</p>

  <% if (kind === 'upcoming') { %>
    <h2>Preview - <%= preview.sourceFilename %> (<%= preview.data.length %> rows)</h2>
    <div class="table-scroll">
    <table>
      <thead><tr><th>Organization</th><th>Title</th><th>Division</th><th>Ref</th><th>Closing</th><th>Warnings</th><th>Skip</th></tr></thead>
      <tbody>
        <% preview.data.forEach((row, i) => { %>
          <tr class="import-row" data-row="<%= i %>">
            <td><input class="edit-org" value="<%= row.organizationRaw %>" style="min-width:12rem;"></td>
            <td><input class="edit-title" value="<%= row.cleanTitle %>" style="min-width:16rem;"></td>
            <td>
              <select class="edit-division">
                <option value="">-</option>
                <% divisions.forEach(d => { %>
                  <option value="<%= d.code %>" <%= row.inferredDivisionCode === d.code ? 'selected' : '' %>><%= d.name %></option>
                <% }) %>
              </select>
            </td>
            <td><%= row.referenceNumber || '-' %></td>
            <td><%= row.closingAt || '-' %></td>
            <td>
              <% row.warnings.forEach(w => { %><div class="badge review" style="margin-bottom:2px;"><%= w %></div><% }) %>
            </td>
            <td><input type="checkbox" class="edit-skip w-auto"></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } else { %>
    <% Object.keys(preview.data).forEach(sheetName => { %>
      <h2><%= sheetName %> (<%= preview.data[sheetName].length %> rows)</h2>
      <div class="table-scroll">
      <table>
        <thead><tr><th>Organization</th><th>Item</th><th>Division</th><th>Deal size</th><th>Officer(s)</th><th>Warnings</th><th>Skip</th></tr></thead>
        <tbody>
          <% preview.data[sheetName].forEach((row, i) => { %>
            <tr class="import-row" data-row="<%= i %>" data-sheet="<%= sheetName %>">
              <td><input class="edit-org" value="<%= row.organizationRaw %>" style="min-width:12rem;"></td>
              <td><input class="edit-title" value="<%= row.cleanTitle %>" style="min-width:16rem;"></td>
              <td>
                <select class="edit-division">
                  <option value="">-</option>
                  <% divisions.forEach(d => { %>
                    <option value="<%= d.code %>" <%= row.inferredDivisionCode === d.code ? 'selected' : '' %>><%= d.name %></option>
                  <% }) %>
                </select>
              </td>
              <td><%= row.dealSize && row.dealSize.amount ? row.dealSize.amount + ' ' + row.dealSize.currency : '-' %></td>
              <td><%= row.accountOfficerNames.join(', ') %></td>
              <td><% row.warnings.forEach(w => { %><div class="badge review" style="margin-bottom:2px;"><%= w %></div><% }) %></td>
              <td><input type="checkbox" class="edit-skip w-auto"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    <% }) %>
  <% } %>

  <form method="post" action="/import/confirm" id="confirm-form" hx-boost="false" class="mt-2">
    <input type="hidden" name="kind" value="<%= kind %>">
    <input type="hidden" name="token" value="<%= preview.token %>">
    <input type="hidden" name="editsJson" id="edits-json">
    <button type="submit">Confirm import</button>
  </form>

  <script>
    document.getElementById('confirm-form').addEventListener('submit', function () {
      var rows = document.querySelectorAll('.import-row');
      var edits = [];
      rows.forEach(function (row) {
        var org = row.querySelector('.edit-org').value;
        var title = row.querySelector('.edit-title').value;
        var division = row.querySelector('.edit-division').value;
        var skip = row.querySelector('.edit-skip').checked;
        edits.push({
          rowIndex: Number(row.dataset.row),
          sheet: row.dataset.sheet || null,
          organizationRaw: org,
          cleanTitle: title,
          divisionCode: division,
          skip: skip,
        });
      });
      document.getElementById('edits-json').value = JSON.stringify(edits);
    });
  </script>
<% } %>

<%- include('../partials/footer') %>
